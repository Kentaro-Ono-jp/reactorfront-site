---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={["brand", { "brand--compact": compact }]}>
  <svg class="brand__mark" viewBox="0 0 44 44" aria-hidden="true">
    <rect width="44" height="44" rx="12" fill="currentColor" />
    <path
      d="M11 10h13c6.6 0 10.5 3.5 10.5 9 0 4.1-2.3 7.1-6.3 8.4l7 6.6h-8.7l-5.6-5.5h-2.6V34H11V10Zm7.3 6.2v6.4h5.4c2.2 0 3.5-1.2 3.5-3.3 0-2-1.3-3.1-3.5-3.1h-5.4Z"
      fill="var(--brand-mark-ink, #eef8f5)"
    />
    <rect x="31" y="7" width="6" height="6" rx="1.5" fill="var(--accent)" />
  </svg>
  <span class="brand__type">
    <strong>ReactorFront</strong>
    <small>Software Engineering</small>
  </span>
</span>
