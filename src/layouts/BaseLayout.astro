---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import {
  createBreadcrumbList,
  kentaroOno,
  ORGANIZATION_ID,
  serializeJsonLd,
  WEBSITE_ID,
  type BreadcrumbItem,
  type JsonLd,
} from "../structured-data";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  noindex?: boolean;
  breadcrumbs?: readonly BreadcrumbItem[];
  structuredData?: JsonLd | readonly JsonLd[];
  webPageType?: string | readonly string[];
  webPageMainEntity?: JsonLd;
}

const {
  title,
  description,
  image = "/images/reactorfront-workspace.webp",
  imageAlt = "東京の夜景を望む窓辺のソフトウェア開発用ワークスペース",
  imageWidth = 1536,
  imageHeight = 1024,
  imageType = "image/webp",
  noindex = false,
  breadcrumbs = [],
  structuredData = [],
  webPageType = "WebPage",
  webPageMainEntity,
} = Astro.props;

const site = Astro.site ?? new URL("https://www.reactorfront.jp/");
const pageTitle = title === "ReactorFront" ? title : `${title} | ReactorFront`;
const canonical = new URL(Astro.url.pathname, site);
const socialImage = new URL(image, site);
const pageStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const articleData = pageStructuredData.find((item) => item["@type"] === "Article");
const openGraphType = articleData ? "article" : "website";
const articlePublishedTime = typeof articleData?.datePublished === "string" ? articleData.datePublished : undefined;
const articleModifiedTime = typeof articleData?.dateModified === "string" ? articleData.dateModified : undefined;
const organization = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": ORGANIZATION_ID,
  name: "ReactorFront",
  legalName: "リアクターフロント",
  alternateName: ["リアクターフロント", "reactorfront"],
  url: "https://www.reactorfront.jp/",
  logo: "https://www.reactorfront.jp/brand/reactorfront-mark-512.png",
  email: "mailto:kentaro.ono@reactorfront.jp",
  founder: kentaroOno,
  sameAs: [
    "https://github.com/Kentaro-Ono-jp/Portfolio",
  ],
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": WEBSITE_ID,
  url: "https://www.reactorfront.jp/",
  name: "ReactorFront",
  alternateName: ["リアクターフロント", "reactorfront"],
  inLanguage: "ja-JP",
  publisher: {
    "@id": ORGANIZATION_ID,
  },
};
const webPage = {
  "@context": "https://schema.org",
  "@type": webPageType,
  "@id": `${canonical.href}#webpage`,
  name: pageTitle,
  url: canonical.href,
  description,
  inLanguage: "ja-JP",
  isPartOf: {
    "@id": WEBSITE_ID,
  },
  publisher: {
    "@id": ORGANIZATION_ID,
  },
  ...(webPageMainEntity ? { mainEntity: webPageMainEntity } : {}),
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: socialImage.href,
    contentUrl: socialImage.href,
    width: imageWidth,
    height: imageHeight,
    caption: imageAlt,
    representativeOfPage: true,
  },
};
const breadcrumbList = breadcrumbs.length >= 2
  ? createBreadcrumbList(breadcrumbs, site)
  : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" href="/brand/reactorfront-mark-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/brand/reactorfront-mark-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/brand/reactorfront-mark-180.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#071b24" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "max-image-preview:large"} />

    <meta property="og:type" content={openGraphType} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="ReactorFront" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {articleData && <meta property="article:author" content="https://www.reactorfront.jp/profile/" />}
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}

    <script is:inline type="application/ld+json" set:html={serializeJsonLd(organization)} />
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(website)} />
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(webPage)} />
    {breadcrumbList && <script is:inline type="application/ld+json" set:html={serializeJsonLd(breadcrumbList)} />}
    {pageStructuredData.map((item) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(item)} />)}
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />

    <script>
      const items = document.querySelectorAll<HTMLElement>("[data-reveal]");

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -8%", threshold: 0.08 },
        );
        items.forEach((item) => observer.observe(item));
      } else {
        items.forEach((item) => item.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
