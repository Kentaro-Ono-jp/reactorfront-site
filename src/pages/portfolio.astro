---
import BaseLayout from "../layouts/BaseLayout.astro";
import { articleReadingMinutes } from "../reading-times";

const slices = [
  {
    number: "01",
    title: "PDF受付と非同期ワークフロー",
    plain: "APIがPDFを受け付け、Outboxとキューを介してMLワーカーへ処理を引き渡します。再試行しても業務状態を壊しません。",
    proves: "Web / API / Object Storage / Queue / Retry",
  },
  {
    number: "02",
    title: "認証付きレビューと排他制御",
    plain: "文書の所有者だけが推論結果を承認・訂正できます。同時操作やリクエスト再送が起きても、最終判断は一度だけ成立します。",
    proves: "Authentication / Authorization / Idempotency / Audit",
  },
  {
    number: "03",
    title: "評価可能なモデルライフサイクル",
    plain: "人の訂正は学習候補として分離し、固定したデータセットでChampionとCandidateを比較してからモデルを昇格します。",
    proves: "Dataset / Evaluation Gate / Lineage / Rollback",
  },
  {
    number: "04",
    title: "実AWSでのデプロイと撤収",
    plain: "Terraformで一時環境を構築し、認証付きE2Eを実行。destroy後は別経路で残存リソースまで検査します。",
    proves: "AWS / Terraform / OIDC / E2E / Residual Sweep",
  },
];
---

<BaseLayout
  title={`ポートフォリオ解説｜約${articleReadingMinutes.overview}分で読む`}
  description={`PDF受付、非同期解析、Human-in-the-loop、監査ログ、モデルライフサイクル、AWS運用を統合したReactorFrontのDocument Intelligence基盤を約${articleReadingMinutes.overview}分で解説します。`}
>
  <section class="page-hero page-hero--portfolio">
    <div class="page-hero__mesh" aria-hidden="true"></div>
    <div class="shell page-hero__inner">
      <div class="breadcrumbs" aria-label="パンくずリスト">
        <a href="/">Home</a><span aria-hidden="true">/</span><span>Portfolio</span>
      </div>
      <div class="page-hero__grid">
        <div>
          <p class="eyebrow eyebrow--accent">{articleReadingMinutes.overview}-minute overview</p>
          <h1>現在は文書分類。<br />文書知能化へ。</h1>
        </div>
        <div class="page-hero__lead">
          <p>
            PDFの受付、AIによる解析、人のレビュー、監査、モデル更新までを統合したDocument Intelligence基盤です。
            公開版では最小の実証として文書分類を実装し、その先の業務文書分析や設計図面の読み取りを見据えています。
          </p>
          <span class="reading-time">約{articleReadingMinutes.overview}分で読めます</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section portfolio-summary">
    <div class="shell portfolio-summary__grid">
      <div data-reveal>
        <p class="eyebrow">In one sentence</p>
        <h2>文書を解析し、<br />人の判断と根拠まで管理する。</h2>
      </div>
      <div class="prose prose--large" data-reveal>
        <p>
          ReactorFront Portfolioは、認証付きでPDFを受け付け、オブジェクトストレージとキューを介して機械学習ワーカーへ処理を渡します。
          現在の推論タスクは「請求書」「報告書」の文書分類ですが、システムの中心は分類モデル単体ではありません。
        </p>
        <p>
          推論結果をHuman-in-the-loopで承認・訂正し、機械の出力と人の判断を別々の監査証跡として保存します。
          さらに、データセット、評価結果、採用モデルを結び付け、モデル更新とロールバックまで追跡できるようにしています。
        </p>
      </div>
    </div>

    <div class="scope-note shell" data-reveal>
      <span class="scope-note__icon" aria-hidden="true">i</span>
      <div>
        <h3>これは再現手順書ではありません</h3>
        <p>
          IT業界で働く方が短時間で構成と設計意図をつかめる概要です。
          同じシステムを再構築できるコード解説や手順ではなく、実装範囲、技術判断、検証結果を確認できる粒度にしています。
        </p>
      </div>
    </div>

    <aside class="reader-bridge shell" data-reveal>
      <div class="reader-bridge__label">
        <span>理解の補助線</span>
        <strong>要するに</strong>
      </div>
      <div>
        <h3>AIの回答を出して終わるデモではありません。</h3>
        <p>
          書類を受け取り、AIが内容を判定し、人が結果を確認し、その判断を後から説明できる形で残すところまでを一つの仕組みにしています。
          AIが間違えた場合は人が訂正でき、その記録を次の改善候補として扱えます。
        </p>
        <p class="reader-bridge__meaning"><strong>実務上の意味</strong>AI任せにせず、担当者の確認と責任を残したまま文書処理を効率化できます。</p>
      </div>
    </aside>
  </section>

  <section class="section section--soft">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">How it works</p>
        <h2>受付から監査までを、<br />非同期ワークフローでつなぐ。</h2>
        <p>ユーザー操作と時間のかかる推論処理を分離し、各段階の状態と責任を明確にしています。</p>
      </div>

      <ol class="portfolio-flow" aria-label="文書処理の4段階">
        <li data-reveal>
          <span class="portfolio-flow__number">01</span>
          <div class="portfolio-flow__visual portfolio-flow__visual--upload" aria-hidden="true">
            <span class="paper-sheet"></span><span class="upload-arrow">↑</span>
          </div>
          <h3>Ingest</h3>
          <p>認証・認可を確認し、PDFと業務レコードを登録します。</p>
          <small>API / Object Storage</small>
        </li>
        <li data-reveal>
          <span class="portfolio-flow__number">02</span>
          <div class="portfolio-flow__visual portfolio-flow__visual--process" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <h3>Analyze</h3>
          <p>キューから依頼を受けたMLワーカーが文書を解析します。</p>
          <small>Queue / ML Worker</small>
        </li>
        <li data-reveal>
          <span class="portfolio-flow__number">03</span>
          <div class="portfolio-flow__visual portfolio-flow__visual--decision" aria-hidden="true">
            <span>✓</span><span>↺</span>
          </div>
          <h3>Review</h3>
          <p>利用者が元文書と推論結果を確認し、承認または訂正します。</p>
          <small>Human-in-the-loop</small>
        </li>
        <li data-reveal>
          <span class="portfolio-flow__number">04</span>
          <div class="portfolio-flow__visual portfolio-flow__visual--record" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <h3>Audit</h3>
          <p>推論、レビュー、モデルの来歴を追跡可能な形で保存します。</p>
          <small>Audit Trail / Lineage</small>
        </li>
      </ol>

      <aside class="reader-bridge" data-reveal>
        <div class="reader-bridge__label">
          <span>理解の補助線</span>
          <strong>非同期とは</strong>
        </div>
        <div>
          <h3>受付を先に済ませ、時間のかかる解析は裏側で進めます。</h3>
          <p>
            PDFを送った画面を処理完了まで固めておくのではなく、まず受付済みの状態を返します。
            利用者は進行状況を確認でき、解析に失敗した場合も、どこで止まったかを残して再実行できます。
          </p>
          <p class="reader-bridge__meaning"><strong>実務上の意味</strong>文書が増えたりAI処理が長引いたりしても、利用者の操作とバックグラウンド処理を互いに巻き込みにくくします。</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section why-section">
    <div class="shell why-section__grid">
      <div class="why-section__sticky" data-reveal>
        <p class="eyebrow">Why it matters</p>
        <h2>MLモデルだけでは、<br />業務システムにならない。</h2>
        <p>
          業務導入では、推論の前後にある認証、状態管理、再実行、レビュー、監査、モデル更新が必要です。
          このポートフォリオは、そのアプリケーション・ML・運用の接続部分を実装しています。
        </p>
      </div>
      <div class="challenge-list">
        <article data-reveal>
          <span>01</span><div><h3>非同期で状態を管理する</h3><p>推論処理をキューへ分離し、APIは処理状態を返します。タイムアウトや再試行も業務状態として扱います。</p></div>
        </article>
        <article data-reveal>
          <span>02</span><div><h3>認証と認可を分ける</h3><p>ログイン済みであることに加え、対象文書を操作できる所有者かをAPI側で検証します。</p></div>
        </article>
        <article data-reveal>
          <span>03</span><div><h3>冪等性と排他制御を持つ</h3><p>リクエスト再送や同時レビューが起きても、最終判断を重複して確定しません。</p></div>
        </article>
        <article data-reveal>
          <span>04</span><div><h3>推論・決定・学習候補を分離する</h3><p>機械の出力、人の最終判断、将来のデータセット候補を異なるレコードとして保存します。</p></div>
        </article>
        <article data-reveal>
          <span>05</span><div><h3>失敗を再実行可能にする</h3><p>Outbox、リトライ、状態遷移を使い、途中で停止した処理を追跡して再開できるようにします。</p></div>
        </article>
      </div>
    </div>

    <aside class="reader-bridge shell" data-reveal>
      <div class="reader-bridge__label">
        <span>理解の補助線</span>
        <strong>なぜ必要か</strong>
      </div>
      <div>
        <h3>同じ依頼が二度届いても、結果を二重に確定しないためです。</h3>
        <p>
          通信の再送や複数人の同時操作は、実際の業務システムでは珍しくありません。
          冪等性や排他制御は、そうした状況でも「承認が二度記録される」「後から来た操作で判断が上書きされる」といった事故を防ぐための仕組みです。
        </p>
        <p class="reader-bridge__meaning"><strong>実務上の意味</strong>操作の重複や途中停止があっても、業務上の最終結果と監査記録を壊しにくくします。</p>
      </div>
    </aside>
  </section>

  <section class="section section--dark slices-section">
    <div class="shell">
      <div class="section-heading section-heading--split" data-reveal>
        <div>
          <p class="eyebrow eyebrow--accent">Four vertical slices</p>
          <h2>4本のVertical Sliceで、<br />実証範囲を拡張した。</h2>
        </div>
        <p>
          各SliceでUIからデータ、非同期処理、テストまでを縦に通し、段階ごとに実行可能な状態を維持しました。
          2026年8月12日時点で、4本すべての受け入れ条件を満たしています。
        </p>
      </div>

      <div class="slice-list">
        {
          slices.map((slice) => (
            <article data-reveal>
              <span class="slice-list__number">{slice.number}</span>
              <div class="slice-list__body">
                <h3>{slice.title}</h3>
                <p>{slice.plain}</p>
              </div>
              <p class="slice-list__proof"><span>示せること</span>{slice.proves}</p>
            </article>
          ))
        }
      </div>

      <aside class="reader-bridge" data-reveal>
        <div class="reader-bridge__label">
          <span>理解の補助線</span>
          <strong>Vertical Sliceとは</strong>
        </div>
        <div>
          <h3>使える一連の流れを、細く一本ずつ完成させる進め方です。</h3>
          <p>
            画面だけ、APIだけ、AIだけを別々に作りためるのではなく、PDF受付から保存、解析、確認までを最小範囲で通します。
            その一本を動く状態にしたまま、次の機能を追加して実証範囲を広げました。
          </p>
          <p class="reader-bridge__meaning"><strong>実務上の意味</strong>開発途中でも動作確認でき、問題が起きた変更範囲を絞りやすくなります。</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section tech-map-section">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">Under the hood</p>
        <h2>Frontend、API、キュー、ML、AWS。</h2>
        <p>各コンポーネントの責務を分離し、明示した契約で接続しています。</p>
      </div>

      <div class="tech-map" data-reveal>
        <article>
          <span class="tech-map__role">Frontend</span>
          <h3>Web Application</h3>
          <p>認証、PDFアップロード、処理状態、推論結果とレビューUI</p>
          <div class="tag-list"><span>Next.js</span><span>React</span></div>
        </article>
        <article>
          <span class="tech-map__role">Application &amp; State</span>
          <h3>API</h3>
          <p>認可、業務状態、Outbox、レビュー確定、監査ログを管理</p>
          <div class="tag-list"><span>FastAPI</span><span>PostgreSQL</span></div>
        </article>
        <article>
          <span class="tech-map__role">Messaging</span>
          <h3>Queue</h3>
          <p>APIとワーカーを分離し、処理依頼の配送と再試行を管理</p>
          <div class="tag-list"><span>RabbitMQ</span><span>Outbox</span></div>
        </article>
        <article>
          <span class="tech-map__role">ML Inference</span>
          <h3>ML Worker</h3>
          <p>採用済みモデルを検証してロードし、推論結果とモデル来歴を返す</p>
          <div class="tag-list"><span>Python</span><span>PyTorch</span></div>
        </article>
        <article>
          <span class="tech-map__role">Cloud Infrastructure</span>
          <h3>AWS</h3>
          <p>Terraformによる構築、E2E、可観測性、destroyと残存確認</p>
          <div class="tag-list"><span>Terraform</span><span>Fargate</span></div>
        </article>
      </div>

      <aside class="reader-bridge" data-reveal>
        <div class="reader-bridge__label">
          <span>理解の補助線</span>
          <strong>なぜ分けるのか</strong>
        </div>
        <div>
          <h3>画面、受付、配送、AI、実行環境を、それぞれ交換・修理できるようにしています。</h3>
          <p>
            一つの巨大なプログラムに全部を詰め込むと、画面の変更がAI処理へ影響したり、処理の遅れで受付まで止まったりします。
            役割と受け渡し方を分けることで、どこを直すべきかを判断しやすくしています。
          </p>
          <p class="reader-bridge__meaning"><strong>実務上の意味</strong>機能追加や障害対応で、関係のない部分まで同時に変更する危険を抑えられます。</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--soft document-intelligence-section">
    <div class="shell">
      <div class="section-heading section-heading--split" data-reveal>
        <div>
          <p class="eyebrow">Beyond classification</p>
          <h2>分類は最初のユースケース。<br />文書分析・図面解析へ。</h2>
        </div>
        <p>
          現在の公開版は分類結果を返しますが、文書受付、非同期処理、人のレビュー、監査、モデルライフサイクルを担う共通基盤は、別の文書解析タスクにも再利用できます。
        </p>
      </div>

      <div class="role-grid">
        <article data-reveal>
          <span>01 / Extract</span><h3>項目・表の構造化</h3>
          <p>請求書や注文書の項目、明細表、フォームの値を抽出し、業務システムで扱える構造化データへ変換する。</p>
        </article>
        <article data-reveal>
          <span>02 / Analyze</span><h3>業務文書の分析</h3>
          <p>契約書や報告書の重要項目、記載漏れ、文書間の差分を検出し、人が確認すべき箇所を提示する。</p>
        </article>
        <article data-reveal>
          <span>03 / Drawing</span><h3>設計図面の読み取り</h3>
          <p>表題欄、文字、記号、寸法、部品候補、改訂差分を座標付きで抽出し、図面レビューへ接続する。</p>
        </article>
        <article data-reveal>
          <span>04 / Govern</span><h3>判断と来歴の管理</h3>
          <p>AIの出力と人の訂正を分離して保存し、どのデータ・モデル・評価条件で処理したかを追跡する。</p>
        </article>
      </div>

      <div class="scope-note" data-reveal>
        <span class="scope-note__icon" aria-hidden="true">i</span>
        <div>
          <h3>業務システムへ育てられる骨格はある。ただし、対象業務ごとの実証は別途必要です</h3>
          <p>
            図面解析や項目抽出は、現在の公開版で実証済みの機能ではありません。導入時には、業務データとアノテーション、OCR・レイアウト解析・画像認識モデルまたはCAD/BIM連携、座標を含む出力スキーマ、専用レビューUI、タスク別の評価指標が必要です。セキュリティ、可用性、監視、処理量とコストも業務要件に合わせて追加設計します。
          </p>
          <p>
            また、現行版は利用者が画面から自由に再学習するサービスではありません。データセットの採用、学習、評価、モデル昇格は、エンジニアがレビュー済みのリポジトリ変更として管理します。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section limitations-section">
    <div class="shell limitations-section__grid">
      <div data-reveal>
        <p class="eyebrow">Honest limitations</p>
        <h2>現在、実証済みなのは<br />ここまで。</h2>
      </div>
      <div data-reveal>
        <p class="limitations-section__lead">
          公開版で動作確認した範囲と、本番導入に必要な追加設計を分けて記載します。
        </p>
        <ul class="plain-list">
          <li>実証済みのMLタスクは、公開可能な合成PDFによる英語文書2種類の分類です。</li>
          <li>評価データは小規模で、実業務における精度や未知データへの一般化性能を保証しません。</li>
          <li>項目抽出、文書分析、OCR、表・図面解析は拡張構想であり、公開版には未実装です。</li>
          <li>AWS環境は常時稼働させず、月次検証時に構築し、E2E後に破棄します。</li>
          <li>高可用性、災害復旧、一般利用者向けの登録・課金、SLAは実証範囲に含みません。</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section aws-story-teaser aws-story-teaser--ml">
    <div class="shell aws-story-teaser__inner" data-reveal>
      <div>
        <p class="eyebrow eyebrow--accent">Continue · {articleReadingMinutes.ml}-minute engineering note</p>
        <h2>機械学習を、どう比べ、<br />どう採用し、どう戻すか。</h2>
        <p>
          評価の難しさ、現行版と候補版、データの版、採用根拠、巻き戻し、人の訂正との距離まで。
          MLシステムで起こりやすい問題に、このポートフォリオがどう対処したかを解説します。
        </p>
        <a class="button button--accent button--large" href="/portfolio/ml/">
          MLの{articleReadingMinutes.ml}分読み物へ
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <ol class="aws-story-teaser__rail" aria-label="機械学習エンジニアリング記事の内容">
        <li><span>01</span><strong>試験条件を固定する</strong><small>Data / Split</small></li>
        <li><span>02</span><strong>現行版と候補版を比べる</strong><small>Metrics / Gates</small></li>
        <li><span>03</span><strong>採用根拠を一つに結ぶ</strong><small>Manifest / Lineage</small></li>
        <li><span>04</span><strong>審査済みの版へ戻す</strong><small>Rollback / Review</small></li>
      </ol>
    </div>
  </section>

  <section class="section aws-story-teaser">
    <div class="shell aws-story-teaser__inner" data-reveal>
      <div>
        <p class="eyebrow eyebrow--accent">Continue · {articleReadingMinutes.aws}-minute field note</p>
        <h2>AWSでは、どう作り、<br />どう確かめ、どう消したか。</h2>
        <p>
          IAMの権限、デプロイ、E2E、ログ、destroy後の残存確認まで。
