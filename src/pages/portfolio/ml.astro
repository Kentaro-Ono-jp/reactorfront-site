---
import BaseLayout from "../../layouts/BaseLayout.astro";

const portfolioCommit = "708056f33d56f1affe2dbe8e1b58f4a722895b88";

const problems = [
  {
    number: "01",
    title: "一つの数字だけでは、良し悪しを決めにくい",
    body: "全体の正解率が上がっても、特定の種類だけ見落としが増えることがあります。どの数字を優先するか決めていないと、更新の判断が揺れます。",
    answer: "全体と種類別の指標を、同じ成績表で確認する。",
  },
  {
    number: "02",
    title: "比較のたびに、試験問題まで変わってしまう",
    body: "前回と今回で使ったデータや分け方が違えば、モデルの差なのか試験条件の差なのか分かりません。悪意がなくても起こりやすい困りごとです。",
    answer: "データと分け方を版として固定し、同じ条件で比べる。",
  },
  {
    number: "03",
    title: "新しいモデルが、今のモデルより良いとは限らない",
    body: "学習が完了し、新しいファイルができたことと、採用してよいことは別です。別の項目が少し悪くなる場合もあります。",
    answer: "最低基準と、現行版からの悪化幅を別々に審査する。",
  },
  {
    number: "04",
    title: "戻したい時に、当時の組み合わせが見つからない",
    body: "モデルだけ残っていても、データ、前処理、評価ルールが違えば同じ状態には戻れません。何が本番で使われたか分からない場合もあります。",
    answer: "採用した一式を結び付け、前の採用版も戻り先として残す。",
  },
  {
    number: "05",
    title: "人の訂正を、すぐ正解データにしたくなる",
    body: "訂正は貴重ですが、利用許諾、入力ミス、個人情報、重複などを確かめる前に学習へ混ぜると、別の問題を持ち込みかねません。",
    answer: "人の判断と、学習データへの採用を別の手続きにする。",
  },
];

const lifecycle = [
  {
    number: "01",
    verb: "固定する",
    title: "データの版と分け方",
    body: "18件の合成文書を、学習12件・調整2件・最終試験4件へ固定します。似たひな型が別の組へ漏れないことも検査します。",
  },
  {
    number: "02",
    verb: "つくる",
    title: "再現できる候補モデル",
    body: "同じデータ、前処理、依存関係、乱数の種から、同じ内容の候補モデルを生成できるようにします。",
  },
  {
    number: "03",
    verb: "測る",
    title: "一件ずつ残る試験結果",
    body: "最終試験の全件について、正解、予測、モデルの点数を残し、集計値をそこから計算し直します。",
  },
  {
    number: "04",
    verb: "比べる",
    title: "現行版と候補版",
    body: "同じ試験問題で、最低基準を満たすか、現行版より許容を超えて悪化していないかを確認します。",
  },
  {
    number: "05",
    verb: "採用する",
    title: "審査済みの一枚の目録",
    body: "合格したモデルと、その根拠になったデータ、評価方針、成績表を一つの採用目録で結びます。",
  },
  {
    number: "06",
    verb: "追いかける",
    title: "予測まで続く来歴",
    body: "実際の予測にも採用版の来歴を添え、後から『どの一式が答えたか』を確認できるようにします。",
  },
];

const references = [
  {
    label: "Portfolio source",
    title: "確認した公開コミット",
    href: `https://github.com/Kentaro-Ono-jp/Portfolio/commit/${portfolioCommit}`,
    note: "2026年8月14日時点のmainと一致",
  },
  {
    label: "Portfolio record",
    title: "モデル開発の全体記録（英語）",
    href: `https://github.com/Kentaro-Ono-jp/Portfolio/blob/${portfolioCommit}/apps/ml/MODEL_DEVELOPMENT.md`,
    note: "データ、評価、採用、巻き戻しの一次資料",
  },
  {
    label: "Portfolio model card",
    title: "モデルカード（英語）",
    href: `https://github.com/Kentaro-Ono-jp/Portfolio/blob/${portfolioCommit}/apps/ml/MODEL_CARD.md`,
    note: "用途、測定結果、限界を明記",
  },
  {
    label: "Architecture decision",
    title: "評価と採用の設計判断（英語）",
    href: `https://github.com/Kentaro-Ono-jp/Portfolio/blob/${portfolioCommit}/ips-microkernel/adr/0021-govern-human-feedback-model-evaluation-and-promotion.md`,
    note: "人の訂正、データ、採用を分離した理由",
  },
  {
    label: "Machine-readable proof",
    title: "現行版と候補版の比較結果",
    href: `https://github.com/Kentaro-Ono-jp/Portfolio/blob/${portfolioCommit}/apps/ml/evaluation/candidate-comparison-v1.json`,
    note: "絶対基準と現行版比の合否を記録",
  },
  {
    label: "Machine-readable proof",
    title: "採用モデルの目録",
    href: `https://github.com/Kentaro-Ono-jp/Portfolio/blob/${portfolioCommit}/apps/ml/evaluation/promoted-model-v1.json`,
    note: "モデルと評価根拠を一つに結ぶ記録",
  },
  {
    label: "Google for Developers",
    title: "モデル配置前の品質検査",
    href: "https://developers.google.com/machine-learning/crash-course/production-ml-systems/deployment-testing",
    note: "固定基準と旧版比較に関する公式解説",
  },
  {
    label: "Google for Developers",
    title: "機械学習エンジニアリングの原則",
    href: "https://developers.google.com/machine-learning/guides/rules-of-ml/",
    note: "モデルだけでなく処理全体を堅く保つ考え方",
  },
  {
    label: "scikit-learn official",
    title: "分類モデルの評価指標",
    href: "https://scikit-learn.org/stable/modules/model_evaluation.html",
    note: "適合率、再現率、F1などの公式解説",
  },
  {
    label: "scikit-learn official",
    title: "予測確率の校正",
    href: "https://scikit-learn.org/stable/modules/calibration.html",
    note: "点数を確率として扱うために必要な検証",
  },
];
---

<BaseLayout
  title="機械学習を育てる設計｜10分で読むポートフォリオ"
  description="機械学習で起こりやすい比較・再現・巻き戻しの困りごとに、ReactorFront Portfolioがどう備えたかを、非エンジニア向けにやさしく解説します。"
>
  <article class="ml-story">
    <header class="page-hero page-hero--ml-story">
      <div class="ml-story__matrix" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="shell page-hero__inner">
        <div class="breadcrumbs" aria-label="パンくずリスト">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/portfolio/">Portfolio</a><span aria-hidden="true">/</span>
          <span>ML engineering</span>
        </div>
        <div class="page-hero__grid">
          <div>
            <p class="eyebrow eyebrow--accent">10-minute engineering note</p>
            <h1>比べる。戻す。<br />だから、育てられる。</h1>
          </div>
          <div class="page-hero__lead">
            <p>
              機械学習は、モデルを一度つくって終わる仕事ではありません。
              新旧を公平に比べ、採用した理由を残し、必要なら前へ戻す。そのための環境をどう設計したか、少しだけ詳しく案内します。
            </p>
            <span class="reading-time">約10分で読めます</span>
          </div>
        </div>
      </div>
    </header>

    <div class="story-meta">
      <div class="shell story-meta__inner">
        <div><span>Audience</span><strong>非エンジニア・学習初期</strong></div>
        <div><span>Source checked</span><strong>2026.08.14</strong></div>
        <div><span>Portfolio main</span><strong><code>708056f</code></strong></div>
        <div><span>Format</span><strong>読み物 / 非チュートリアル</strong></div>
      </div>
    </div>

    <section class="section story-opening">
      <div class="shell story-opening__grid">
        <div data-reveal>
          <p class="eyebrow">The engineering around ML</p>
          <h2>性能を上げる前に、<br />上げ続けられる場所をつくる。</h2>
        </div>
        <div class="prose prose--large" data-reveal>
          <p>
            モデルの中には、入力のどこを重く見るかを表す多くの値があります。学習をやり直せば、それらは少しずつ変わります。
            しかし、重みを一個ずつ見比べても、利用者にとって良くなったかは簡単には分かりません。
          </p>
          <p>
            そこでこの作品は、モデルの中身だけでなく、<strong>同じ条件で測る、現行版と比べる、採用根拠を固定する、予測まで来歴をつなぐ</strong>ところへ力を注ぎました。
            機械学習そのものの高性能さではなく、改善を安全に繰り返すためのエンジニアリングを示すポートフォリオです。
          </p>
        </div>
      </div>

      <div class="scope-note shell" data-reveal>
        <span class="scope-note__icon" aria-hidden="true">i</span>
        <div>
          <h3>この記事は、モデルを再現するための手順書ではありません</h3>
          <p>
            公開リポジトリの設計、コード、試験結果を根拠にしていますが、学習コードや設定を順番に写す記事ではありません。
            読後に「機械学習を育てる環境で、何を考えたか」が分かる粒度に留めています。
          </p>
        </div>
      </div>
    </section>

    <section class="section section--soft ml-problems-section" id="problems">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow">Common, not careless</p>
            <h2>続けるほど出会う、<br />機械学習の困りごと。</h2>
          </div>
          <p>
            どれも珍しい失敗ではありません。データ、モデル、評価が少しずつ変わる仕事だからこそ、開発を続けるうちに自然と起こりやすい問題です。
          </p>
        </div>

        <div class="ml-problem-list">
          {
            problems.map((problem) => (
              <article data-reveal>
                <span>{problem.number}</span>
                <div>
                  <h3>{problem.title}</h3>
                  <p>{problem.body}</p>
                </div>
                <strong><small>この作品では</small>{problem.answer}</strong>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section--dark ml-lifecycle-section" id="lifecycle">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow eyebrow--accent">One governed loop</p>
            <h2>データから予測まで、<br />一本の根拠でつなぐ。</h2>
          </div>
          <p>
            この作品では、学習だけを独立した魔法の箱にしません。前後の判断を六つの段階に分け、どこで何を固定したかを追えるようにしました。
          </p>
        </div>

        <ol class="ml-lifecycle" aria-label="モデル開発と採用の6段階">
          {
            lifecycle.map((step) => (
              <li data-reveal>
                <div class="ml-lifecycle__head"><span>{step.number}</span><strong>{step.verb}</strong></div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section ml-evaluation-story" id="evaluation">
      <div class="shell">
        <div class="ml-evaluation-story__lead" data-reveal>
          <div>
            <p class="eyebrow">A readable scorecard</p>
            <h2>「全部で何点」だけに、<br />まとめない。</h2>
          </div>
          <div class="prose">
            <p>
              たとえば請求書の見落としが増えた一方で、報告書だけよく当たるようになれば、全体の数字では変化が隠れることがあります。
              この作品は、請求書と報告書をそれぞれ分けて測り、最後に全体を見ます。
            </p>
            <p>
              モデル内部の重みの増減ではなく、<strong>実際の試験文書にどう答えたか</strong>を採用判断に使う設計です。
            </p>
          </div>
        </div>

        <div class="metric-explainer">
          <article data-reveal>
            <span>Precision / 適合率</span>
            <h3>そう予測した中で、<br />どれだけ正しかったか。</h3>
            <p>「請求書です」と答えた文書の中に、報告書がどれだけ混ざったかを見る感覚です。</p>
          </article>
          <article data-reveal>
            <span>Recall / 再現率</span>
            <h3>本当にそうだった物を、<br />どれだけ拾えたか。</h3>
            <p>本物の請求書を、見落とさずに請求書として見つけられたかを見る感覚です。</p>
          </article>
          <article data-reveal>
            <span>F1 / バランス</span>
            <h3>混入と見落としを、<br />一緒に眺める。</h3>
            <p>適合率と再現率の片方だけが高い状態を避け、二つの釣り合いを見ます。</p>
          </article>
          <article data-reveal>
            <span>Macro F1 / 種類を公平に</span>
            <h3>件数の多い種類だけを、<br />有利にしない。</h3>
            <p>種類ごとのF1を同じ重さで平均し、少ない種類の不調も見えやすくします。</p>
          </article>
        </div>

        <div class="ml-report" data-reveal>
          <div class="ml-report__copy">
            <p class="eyebrow">Observed / bounded fixture</p>
            <h3>今回の小さな成績表</h3>
            <p>
              最終試験は公開用に作った合成文書4件です。候補版は4件すべてを処理し、請求書・報告書ともに各指標1.0でした。
              ただし、これは評価の仕組みが最後まで通った証拠であり、実世界で100%当たるという意味ではありません。
            </p>
          </div>
          <div class="ml-report__score" aria-label="候補モデルの限定的な評価結果">
            <div><span>Processed</span><strong>4 / 4</strong><small>held-out synthetic samples</small></div>
            <div><span>Macro F1</span><strong>1.0</strong><small>invoice + report</small></div>
            <div><span>Per-class recall</span><strong>1.0</strong><small>both classes</small></div>
            <div><span>Failures</span><strong>0</strong><small>sanitized failures</small></div>
          </div>
        </div>

        <div class="calibration-note" data-reveal>
          <span aria-hidden="true">≠</span>
          <div>
            <h3>高い「点数」を、そのまま確率とは呼ばない</h3>
            <p>
              画面に近い値が出ても、「99%の確率で正しい」と言うには別の校正試験が必要です。この作品は校正を行っていないため、値をモデルの点数と呼び、確率や信頼度の証明には使いません。
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--soft ml-comparison-story" id="comparison">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow">Champion vs candidate</p>
            <h2>新しいからではなく、<br />審査を通ったから採用する。</h2>
          </div>
          <p>
            現在使っている版を「現行版」、次の提案を「候補版」として、同じ試験条件で横に並べます。新しいファイルができただけでは入れ替えません。
          </p>
        </div>

        <figure class="model-gate" data-reveal>
          <figcaption>Reviewed model promotion / 実際の比較記録をやさしく図解</figcaption>
          <div class="model-gate__model model-gate__model--champion">
            <span>Champion / 現行版</span>
            <strong>document-type-v1</strong>
            <small>Macro F1 1.0</small>
          </div>
          <div class="model-gate__checks">
            <span>Gate 01</span><strong>最低基準を満たす</strong><small>絶対評価</small>
            <i aria-hidden="true">＋</i>
            <span>Gate 02</span><strong>許容を超えて悪化しない</strong><small>現行版との比較</small>
          </div>
          <div class="model-gate__model model-gate__model--candidate">
            <span>Candidate / 候補版</span>
            <strong>document-type-candidate-v1</strong>
            <small>Eligible / 採用可能</small>
          </div>
        </figure>

        <div class="comparison-facts">
          <article data-reveal>
            <span>Absolute</span>
            <h3>合格点を先に決める</h3>
            <p>Macro F1、種類別の再現率、全件処理、失敗件数などに最低条件があります。</p>
          </article>
          <article data-reveal>
            <span>Relative</span>
            <h3>今より悪くないかを見る</h3>
            <p>全体、種類別、モデルの点数について、現行版から許せる悪化幅を超えないか見ます。</p>
          </article>
          <article data-reveal>
            <span>Recomputed</span>
            <h3>集計表を計算し直す</h3>
            <p>各文書の結果から指標と合否を再計算し、書かれた合計値だけを信用しません。</p>
          </article>
        </div>

        <p class="ml-comparison-story__closing" data-reveal>
          今回の候補版は現行版を大きく上回ったのではなく、定めた最低基準を満たし、この小さな試験範囲では悪化がないと確認されました。
          その違いを正直に残すことも、評価環境の役目です。
        </p>
      </div>
    </section>

    <section class="section section--dark ml-checkpoint-story" id="rollback">
      <div class="shell ml-checkpoint-story__grid">
        <div class="ml-checkpoint-story__copy" data-reveal>
          <p class="eyebrow eyebrow--accent">A release checkpoint</p>
          <h2>戻すのは、<br />モデル一個ではない。</h2>
          <p>
            ここでいう「戻れる地点」は、学習途中の一瞬を保存する一般的なチェックポイントとは少し違います。
            この作品が残すのは、審査を通った<strong>リリース一式</strong>です。
          </p>
          <p>
            前の現行版も、同じルールで確認された戻り先として残ります。問題があれば、過去を書き換えず、審査された目録を前の一式へ切り替えます。
          </p>
        </div>

        <figure class="lineage-manifest" data-reveal>
          <figcaption>Promoted model manifest / 採用目録</figcaption>
          <div class="lineage-manifest__selected">
            <span>Selected</span>
            <strong>候補モデル v1</strong>
            <small>内容を表すSHA-256付き</small>
          </div>
          <div class="lineage-manifest__links" aria-label="採用モデルに結び付く根拠">
            <span>データの版</span>
            <span>学習・試験の分け方</span>
            <span>前処理</span>
            <span>学習パイプライン</span>
            <span>評価方針</span>
            <span>評価レポート</span>
            <span>分類する種類</span>
            <span>候補比較</span>
          </div>
          <div class="lineage-manifest__rollback">
            <span>Reviewed rollback target</span>
            <strong>前の現行モデル v1</strong>
            <small>同じ審査経路で選び直す</small>
          </div>
        </figure>
      </div>
    </section>

    <section class="section ml-lineage-story" id="lineage">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow">Evidence at runtime</p>
            <h2>答えだけでなく、<br />誰が答えたかを残す。</h2>
          </div>
          <p>
            採用時の記録が立派でも、実際の予測とつながっていなければ追跡できません。この作品では、処理結果にモデルの来歴を添えて保存します。
          </p>
        </div>

        <div class="runtime-lineage" data-reveal>
          <div class="runtime-lineage__prediction">
            <span>Machine result</span>
            <strong>この文書は「請求書」</strong>
            <small>model score / machine decision</small>
          </div>
          <span class="runtime-lineage__arrow" aria-hidden="true">＋</span>
          <div class="runtime-lineage__evidence">
            <span>Dataset</span><span>Preprocessing</span><span>Pipeline</span><span>Model artifact</span>
            <span>Policy</span><span>Evaluation report</span><span>Version</span><span>SHA-256</span>
          </div>
        </div>

        <div class="runtime-rules">
          <article data-reveal>
            <span>Startup</span>
            <h3>組み合わせが違えば、起動しない</h3>
            <p>モデルの内容や評価根拠が採用目録と一致しない時は、最新版らしいファイルを勝手に使わず停止します。</p>
          </article>
          <article data-reveal>
            <span>Persistence</span>
            <h3>後の判断で、機械の結果を書き換えない</h3>
            <p>人が承認・訂正しても、その時の機械の答えと来歴は別の証拠として残ります。</p>
          </article>
          <article data-reveal>
            <span>Audit</span>
            <h3>後から、同じ根拠をたどれる</h3>
            <p>どのデータ、処理、モデル、評価で許可された予測かを、記録された識別子から確認できます。</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--soft ml-feedback-story" id="feedback">
      <div class="shell ml-feedback-story__grid">
        <div data-reveal>
          <p class="eyebrow">Human feedback boundary</p>
          <h2>人の訂正は大切。<br />だから、急いで混ぜない。</h2>
          <div class="prose">
            <p>
              利用者が機械の答えを直した時、それは将来の改善材料になります。ただし「人が直した」という事実だけでは、学習に使ってよいデータとは限りません。
            </p>
            <p>
              この作品では、訂正をまず<strong>候補</strong>として分離します。出所と利用許諾、内容の同一性、分類の妥当性、重複や漏えいを人が確認し、別の審査を通ったものだけが将来のデータ版へ進めます。
            </p>
          </div>
        </div>

        <div class="feedback-route" data-reveal>
          <div><span>01</span><strong>人が予測を訂正</strong><small>製品上の最終判断</small></div>
          <i aria-hidden="true">↓</i>
          <div><span>02</span><strong>最小限の候補へ分離</strong><small>個人情報や本文を持ち込まない</small></div>
          <i aria-hidden="true">↓</i>
          <div><span>03</span><strong>人が利用可否を審査</strong><small>出所・許諾・重複・漏えい</small></div>
          <i aria-hidden="true">↓</i>
          <div><span>04</span><strong>将来のデータ版へ</strong><small>採用時は変更履歴を残す</small></div>
          <p><span aria-hidden="true">×</span> 自動で再学習・自動で本番採用はしない</p>
        </div>
      </div>
    </section>

    <section class="section ml-proof-story">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow">Proof, not paperwork</p>
            <h2>目録を書くだけでなく、<br />壊して確かめる。</h2>
          </div>
          <p>
            公開リポジトリの自動試験は、正しい候補が通ることだけでなく、来歴を改ざんした候補や未審査の最新版が拒否されることも確認します。
          </p>
        </div>

        <div class="ml-proof-grid">
          <article data-reveal>
            <span>01 / Rebuild</span>
            <h3>同じ候補を二度つくる</h3>
            <p>同じ入力から生成した二つのモデルが、内容も識別用の値も一致するか確認します。</p>
          </article>
          <article data-reveal>
            <span>02 / Re-evaluate</span>
            <h3>成績表を二度つくる</h3>
            <p>全試験を二度実行し、各文書の結果から再計算したレポートが一字単位で一致するか見ます。</p>
          </article>
          <article data-reveal>
            <span>03 / Reject</span>
            <h3>壊れた来歴を拒否する</h3>
            <p>データやレポートの結び付きを変えた場合に、採用判定と実行環境が止まることを確認します。</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section story-limitations">
      <div class="shell story-limitations__grid">
        <div data-reveal>
          <p class="eyebrow">Honest boundary</p>
          <h2>この仕組みが、<br />証明しないこと。</h2>
        </div>
        <ul class="plain-list" data-reveal>
          <li>対象は英語の請求書と報告書だけで、公開用に作った小さな合成データです。</li>
          <li>最終試験は4件だけです。各指標1.0でも、実業務の精度や一般化性能は証明しません。</li>
          <li>画像、手書き、OCR、複数ページ、表組み、未知の書式、時間によるデータ変化は評価していません。</li>
          <li>予測の点数は校正済みの確率ではなく、公平性、頑健性、プライバシーも評価対象外です。</li>
          <li>大規模な組織向けのオンラインモデル管理基盤や、自動再学習の仕組みではありません。</li>
          <li>この記事は、同じモデルや評価環境を組み立てる操作マニュアルではありません。</li>
        </ul>
      </div>
    </section>

    <section class="section section--dark references-section">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow eyebrow--accent">Sources &amp; verification</p>
            <h2>やさしく話す。<br />根拠は実装につなぐ。</h2>
          </div>
          <p>
            本文は、2026年8月14日時点のPortfolio mainにあるモデルカード、設計判断、機械可読の評価記録、検証コードを照合して再構成しました。
          </p>
        </div>

        <div class="reference-list">
          {
            references.map((reference) => (
              <a href={reference.href} target="_blank" rel="noreferrer" data-reveal>
                <span>{reference.label}</span>
                <strong>{reference.title}</strong>
