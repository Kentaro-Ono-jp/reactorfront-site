---
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { articleReadingMinutes } from "../../../reading-times";
import { getArticleRouteMetadata, SITE_URL } from "../../../site-metadata";
import { createArticle, type BreadcrumbItem } from "../../../structured-data";

const breadcrumbs = [
  { name: "ホーム", href: "/" },
  { name: "ポートフォリオ", href: "/portfolio/" },
  { name: "AWS実地検証", href: "/portfolio/aws/" },
  { name: "ECR 1セント追跡", href: "/portfolio/aws/one-cent-ecr/" },
] satisfies BreadcrumbItem[];

const verifiedAt = "2026-08-23";
const articleTitle = "AWSの1セント増加からECRの残存9 imageを特定・削除した記録";
const articleDescription = "操作していない期間に増えた正しいECR保管料を追跡し、3 repository × 3世代の残存9 imageを安全に0件へ戻したReactorFront（リアクターフロント）の調査記録です。";
const articleMetadata = getArticleRouteMetadata("/portfolio/aws/one-cent-ecr/");
const canonical = new URL(articleMetadata.path, SITE_URL).href;
const representativeImage = "https://www.reactorfront.jp/images/aws-cost-explorer-2026-08-23.png";
const { datePublished, lastModified: dateModified } = articleMetadata;
const articleSchema = createArticle({
  canonical,
  headline: articleTitle,
  description: articleDescription,
  images: [representativeImage],
  datePublished,
  dateModified,
});

const imageGenerations = [
  {
    label: "世代 01",
    tag: "issue110-0580ae23",
    note: "管理対象環境の初回実地検証",
  },
  {
    label: "世代 02",
    tag: "sha-860c4c9ac91d",
    note: "有効期限付き環境を確かめた試行",
  },
  {
    label: "世代 03",
    tag: "sha-a1bad6a7af7d",
    note: "RabbitMQの接続構成を修正した試行",
  },
];

const repositories = [
  { name: "web", role: "Webアプリケーション" },
  { name: "api", role: "バックエンドAPI" },
  { name: "ml", role: "MLサービス" },
];

const investigationSignals = [
  {
    label: "料金 / Cost Explorer",
    title: "保管料だけが積み上がった",
    body: "ECRのusage typeはTimedStorage-ByteHrsのみ。データ転送や新しい実行料金ではありませんでした。",
  },
  {
    label: "操作履歴 / CloudTrail",
    title: "新しい書き込みはなかった",
    body: "木曜から金曜の変化に対応するPutImageやBatchDeleteImageはなく、最後のECR書き込みはそれ以前でした。",
  },
  {
    label: "現在の実体 / ECR inventory",
    title: "9個のタグ付きイメージが残っていた",
    body: "3つの永続リポジトリに、過去3世代のコンテナが同じ構成で残っていました。",
  },
];

const broadDeleteRisks = [
  {
    number: "01",
    title: "別実行のイメージ",
    body: "手動実行、月次実行、別の試行が同じ永続repositoryを使います。残ったtagの所有元を確認せず消すことはできません。",
  },
  {
    number: "02",
    title: "中断からの復旧",
    body: "push後、復旧用の記録（checkpoint）を残す前に止まったimageは、再開時に正しい内容識別子（digest）として採用できる可能性があります。",
  },
  {
    number: "03",
    title: "再起動と再スケール",
    body: "参照中のイメージを消せば、稼働中タスクが落ちなくても、次の起動やスケールアウトを壊し得ます。",
  },
  {
    number: "04",
    title: "失敗の証拠",
    body: "不明なタグは、調査すべき異常そのものです。cleanupが先に消すと、原因を確かめる材料まで失います。",
  },
];

const sources = [
  {
    label: "ReactorFrontの親記事",
    title: "AWSデプロイと撤収",
    href: "/portfolio/aws/",
    note: "本記事の親となる実AWS検証記事",
  },
  {
    label: "Portfolio Issue #133",
    title: "Detect stale ECR images in the final zero-residue sweep",
    href: "https://github.com/Kentaro-Ono-jp/Portfolio/issues/133",
    note: "検知境界を修正した公開Issue",
  },
  {
    label: "Portfolio PR #134",
    title: "Detect stale ECR images in the final sweep",
    href: "https://github.com/Kentaro-Ono-jp/Portfolio/pull/134",
    note: "AWS書き込み0で検証した修正差分",
  },
  {
    label: "Portfolio commit",
    title: "fix(aws): detect stale ECR residue",
    href: "https://github.com/Kentaro-Ono-jp/Portfolio/commit/eac250a38e3e",
    note: "mainへ反映された公開実装",
  },
  {
    label: "AWS公式資料",
    title: "Amazon ECR pricing",
    href: "https://aws.amazon.com/ecr/pricing/",
    note: "保存データ量に基づく公式料金",
  },
  {
    label: "AWS公式資料",
    title: "Cost Explorer resource-level data",
    href: "https://docs.aws.amazon.com/cost-management/latest/userguide/ce-resource-daily.html",
    note: "日次・リソース粒度と反映境界の公式資料",
  },
];
---

<BaseLayout
  title={articleTitle}
  description={articleDescription}
  image="/images/aws-cost-explorer-2026-08-23.png"
  imageAlt="AWS Cost Explorerで2026年8月の合計2.43ドルとECR 0.04ドルを確認した画面"
  imageWidth={787}
  imageHeight={627}
  imageType="image/png"
  breadcrumbs={breadcrumbs}
  structuredData={articleSchema}
>
  <article class="ecr-cost-story">
    <header class="page-hero page-hero--ecr-cost">
      <div class="ecr-cost-hero__signal" aria-hidden="true">
        <span>$0.03</span>
        <i>→</i>
        <strong>$0.04</strong>
      </div>
      <div class="shell page-hero__inner">
        <Breadcrumbs items={breadcrumbs} />
        <div class="page-hero__grid">
          <div>
            <p class="eyebrow eyebrow--accent">AWS費用と残存imageの追跡記録</p>
            <h1>たかが1セント。<br />されど1セント。</h1>
          </div>
          <div class="page-hero__lead">
            <p>
              Portfolioには2週間以上触っていない。それでもAWSの当月合計は、ある日1セント増えました。
              請求の誤りではなく、残っていたECR imageの正しい保管料でした。その原因と、残存0件の判定が見逃していた範囲を特定し、安全に削除した記録です。
            </p>
            <div class="article-byline" aria-label="記事情報">
              <span>著者 <a href="/profile/" rel="author">小野賢太郎</a></span>
              <span>公開 <time datetime={datePublished}>2026年8月23日</time></span>
              <span>最終更新 <time datetime={dateModified}>2026年8月23日</time></span>
            </div>
            <span class="reading-time">約{articleReadingMinutes.awsOneCent}分 / 実地確認: {verifiedAt}</span>
          </div>
        </div>
      </div>
    </header>

    <section class="story-meta" aria-label="記事の要点">
      <div class="shell story-meta__inner">
        <div><span>観測したAWS合計</span><strong>$2.42 → $2.43</strong></div>
        <div><span>ECRの日次増加額</span><strong>$0.003241094</strong></div>
        <div><span>残っていたimage</span><strong>3 repository × 3世代</strong></div>
        <div><span>削除後の再確認</span><strong>0 image</strong></div>
      </div>
    </section>

    <section class="section ecr-cost-prologue" aria-labelledby="ecr-prologue-title">
      <div class="shell ecr-cost-prologue__grid">
        <div data-reveal>
          <p class="eyebrow">追加操作がない期間の変化</p>
          <h2 id="ecr-prologue-title">触っていない。<br />なのに、増えた。</h2>
        </div>
        <div class="prose prose--large" data-reveal>
          <p>
            2026年8月、5回のデプロイ試行を終えた後、ポートフォリオのAWS環境には2週間以上追加操作をしていませんでした。
            それでもCost Explorerの合計は <strong>$2.42</strong> から <strong>$2.43</strong> へ変わりました。
          </p>
          <p>
            1セントなら誤差として流せます。しかし「操作していないのに増えた」は、片付けたつもりの何かが残っている可能性を示します。
            調べた結果、AWSの請求は正しく、こちらの完了判定が一段だけ足りませんでした。
          </p>
          <blockquote class="one-cent-thesis">
            <span>01¢</span>
            <p><strong>料金は正しかった。</strong>「残存0件」という完了判定の方を、もう一度疑う必要があった。</p>
          </blockquote>
        </div>
      </div>
    </section>

    <section class="section section--dark micro-cost-section" aria-labelledby="micro-cost-title">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow eyebrow--accent">画面上の丸めと内部の正確な金額</p>
            <h2 id="micro-cost-title">約0.003ドル/日。<br />普通は、1日では見えない。</h2>
          </div>
          <p>
            Cost Explorerの画面はセント単位でも、内部ではさらに細かい金額が積み上がります。
            今回は初日の値が表示境界の直前だったため、偶然翌日に変化が見えました。
          </p>
        </div>

        <div class="micro-cost-ledger" data-reveal aria-label="ECR累積費用が2026年8月20日の0.034983709ドルから8月21日の0.038224803ドルへ増え、画面表示が0.03ドルから0.04ドルへ変化した">
          <div class="micro-cost-ledger__threshold">
            <span>2桁表示の境界</span><code>$0.035</code>
          </div>
          <article>
            <span>8月20日 / 内部の正確な値</span>
            <code>$0.034983709</code>
            <strong>画面表示 $0.03</strong>
            <i style="--position: 49.8%"></i>
          </article>
          <article>
            <span>8月21日 / 内部の正確な値</span>
            <code>$0.038224803</code>
            <strong>画面表示 $0.04</strong>
            <i style="--position: 82%"></i>
          </article>
        </div>

        <div class="micro-cost-math" data-reveal>
          <div><span>1日あたりの増加</span><strong>$0.003241094</strong></div>
          <i aria-hidden="true">×</i>
          <div><span>約</span><strong>3.09日</strong></div>
          <i aria-hidden="true">→</i>
          <div class="micro-cost-math__result"><span>画面に見える変化</span><strong>約1セント</strong></div>
        </div>

        <aside class="reader-bridge reader-bridge--dark" data-reveal>
          <div class="reader-bridge__label">
            <span>理解の補助線</span>
            <strong>検知できた偶然</strong>
          </div>
          <div>
            <h3>$0.034983709は、$0.035のわずか手前でした。</h3>
            <p>
              もう少し低い値から始まっていれば、翌日も画面は$0.03のままです。
              約0.003ドル/日の請求を2桁表示だけで監視することは難しく、今回は「1日で見つけられる位置にいた」にすぎません。
            </p>
            <p class="reader-bridge__meaning"><strong>実務上の意味</strong>請求画面の見た目だけを、日次の残存検知には使えません。</p>
          </div>
        </aside>
      </div>
    </section>

    <section class="section attribution-section" aria-labelledby="attribution-title">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow">料金・操作履歴・現在の実体を照合</p>
            <h2 id="attribution-title">操作ではなく、<br />保管だった。</h2>
          </div>
          <p>
            請求、操作履歴、現在の実体は別の記録です。一つの画面だけで結論を出さず、三つを照合しました。
          </p>
        </div>

        <div class="investigation-signals">
          {
            investigationSignals.map((signal, index) => (
              <article data-reveal>
                <span>0{index + 1} / {signal.label}</span>
                <h3>{signal.title}</h3>
                <p>{signal.body}</p>
              </article>
            ))
          }
        </div>

        <figure class="ecr-cost-screen" data-reveal>
          <a href="/images/aws-cost-explorer-2026-08-23.png" target="_blank" rel="noreferrer" aria-label="AWS Cost Explorerの2.43ドルの画面を原寸で見る">
            <img
              src="/images/aws-cost-explorer-2026-08-23.png"
              width="787"
              height="627"
              loading="lazy"
              decoding="async"
              alt="2026年8月23日のAWS Cost Explorer。合計2.43ドルで、EC2 Container Registryは0.04ドル。"
            />
            <span>原寸で確認 <i aria-hidden="true">↗</i></span>
          </a>
          <figcaption>
            <span>2026年8月23日の観測</span>
            <strong>ECRの$0.04は、新しいデプロイではなく、残っていたイメージの保管料でした。</strong>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section section--soft image-inventory-section" aria-labelledby="image-inventory-title">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow">3 repository × 3世代の内訳</p>
            <h2 id="image-inventory-title">3サービス × 3世代。<br />合計9イメージ。</h2>
          </div>
          <p>
            ここでいうimageはIAM Role、Policy、Quotaではありません。Web、API、MLを動かすDocker containerです。
          </p>
        </div>

        <div class="ecr-matrix-wrap" data-reveal>
          <table class="ecr-matrix">
            <caption class="sr-only">ECRの3リポジトリに残っていた3世代、合計9コンテナイメージ</caption>
            <thead>
              <tr>
                <th scope="col">repository</th>
                {imageGenerations.map((generation) => <th scope="col"><span>{generation.label}</span><code>{generation.tag}</code></th>)}
              </tr>
            </thead>
            <tbody>
              {
                repositories.map((repository) => (
                  <tr>
                    <th scope="row"><strong>{repository.name}</strong><span>{repository.role}</span></th>
                    {imageGenerations.map(() => <td><span aria-hidden="true">●</span><strong>tag付きimage</strong></td>)}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="retention-facts">
          <article data-reveal>
            <span>自動削除条件 01</span><strong>tagなし / 7日後</strong>
            <p>9個はすべてタグ付きでした。この自動削除条件には入りません。</p>
          </article>
          <article data-reveal>
            <span>自動削除条件 02</span><strong>tag付き / 20個まで保持</strong>
            <p>各リポジトリは3個だけ。保持上限20を超えないため削除されません。</p>
          </article>
          <article data-reveal>
            <span>残す物と消す物の境界</span><strong>空のrepositoryは残し、imageは消す</strong>
            <p>次回も使う空の置き場は永続。実行ごとの中身は撤収対象です。</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section sweep-gap-section" aria-labelledby="sweep-gap-title">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow">残存確認が見ていた範囲の抜け</p>
            <h2 id="sweep-gap-title">今回のタグは消した。<br />過去タグは見ていなかった。</h2>
          </div>
          <p>
            既存の残存確認は、その実行の <code>config.image_tag</code> が消えたことを正しく確認していました。
            しかし、別の試行で残ったタグは問い合わせ対象に入っていませんでした。
          </p>
        </div>

        <div class="query-change" data-reveal>
          <article>
            <span>修正前 / 今回の実行だけを確認</span>
            <pre><code>describe-images
  --repository-name exact-repository
  --image-ids imageTag=config.image_tag</code></pre>
            <p>今回のタグがなければ0。古いタグが同じリポジトリにあっても見えません。</p>
          </article>
          <i aria-hidden="true">→</i>
          <article class="query-change__after">
            <span>修正後 / repository内をすべて確認</span>
            <pre><code>describe-images
  --repository-name exact-repository</code></pre>
            <p>repository内の全imageを数え、1個でもあれば「残存0件」と判定しません。</p>
          </article>
        </div>

        <div class="scope-split" data-reveal>
          <article class="scope-split__mutation">
            <span>削除してよい範囲</span>
            <h3>消す範囲は、狭く。</h3>
            <strong>今回のtag + 復旧記録のdigest</strong>
            <p>自分の実行が所有し、内容識別子（digest）まで一致したimageだけを削除します。</p>
          </article>
          <div aria-hidden="true"><span>≠</span><small>役割を分ける</small></div>
          <article class="scope-split__observation">
            <span>存在を確認する範囲</span>
            <h3>見る範囲は、広く。</h3>
            <strong>指定した3 repository内の全image</strong>
            <p>不明な残存物を黙認せず、残存確認を失敗させて人の調査へ回します。</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--dark broad-delete-section" aria-labelledby="broad-delete-title">
      <div class="shell">
        <div class="broad-delete-lead" data-reveal>
          <p class="eyebrow eyebrow--accent">検知で止め、自動で全削除しない理由</p>
          <h2 id="broad-delete-title">なぜタグを外して、<br />全部消さないのか。</h2>
          <p>
            技術的に全削除できないからではありません。自動cleanupへ「この置き場にあるものは、所有元を問わず消してよい」という判断を持たせないためです。
          </p>
        </div>

        <div class="broad-delete-risks">
          {
            broadDeleteRisks.map((risk) => (
              <article data-reveal>
                <span>{risk.number}</span>
                <h3>{risk.title}</h3>
                <p>{risk.body}</p>
              </article>
            ))
          }
        </div>

        <blockquote class="design-verdict" data-reveal>
          <p><span>検知</span> 全部見る。残っていれば止める。</p>
          <p><span>削除</span> 所有権を証明できるものだけ消す。</p>
          <strong>できないからではなく、させない。</strong>
        </blockquote>

        <aside class="reader-bridge reader-bridge--dark" data-reveal>
          <div class="reader-bridge__label">
            <span>理解の補助線</span>
            <strong>安全側の不便</strong>
          </div>
          <div>
            <h3>残存imageが見つかれば、自動確認を失敗させ、人が正体を確かめます。</h3>
            <p>
              その一手間は自動化の失敗ではなく、調整破壊を避ける安全コストです。
              将来、意図的な保持物を置くなら、先に環境・実行・参照中のdigestを識別できる所有権の記録が必要です。
            </p>
            <p class="reader-bridge__meaning"><strong>実務上の意味</strong>「空であるべき」と「何でも消してよい」を同じ意味にしません。</p>
          </div>
        </aside>
      </div>
    </section>

    <section class="section cleanup-result-section" aria-labelledby="cleanup-result-title">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow">対象を照合した一度限りの削除</p>
            <h2 id="cleanup-result-title">9個を明示削除し、<br />0を読み返す。</h2>
          </div>
          <p>
            既存の9個は、3 repositoryと3 tagが事前確認と完全一致した場合だけ、専用のdestroy Roleで削除しました。
          </p>
        </div>

        <div class="cleanup-result-grid" data-reveal>
          {
            repositories.map((repository) => (
              <article>
                <span>reactorfront/{repository.name}</span>
                <div><strong>3</strong><i aria-hidden="true">→</i><strong>0</strong></div>
                <p>imageの一覧 / 識別子</p>
              </article>
            ))
          }
          <article class="cleanup-result-grid__total">
            <span>合計</span>
            <div><strong>9</strong><i aria-hidden="true">→</i><strong>0</strong></div>
            <p>tag付き / tagなしの両方で残存なし</p>
          </article>
        </div>

        <div class="cleanup-boundary" data-reveal>
          <div><span>残したもの</span><strong>3つの空ECRリポジトリ</strong><p>次回の月次検証でも使う永続管理基盤。</p></div>
          <div><span>消したもの</span><strong>9つの実行イメージ</strong><p>過去の試行で残った保管課金対象。</p></div>
          <div><span>変わらないもの</span><strong>既計上の$2.43</strong><p>累積実績は戻らず、将来の保管増加を止めます。</p></div>
        </div>
      </div>
    </section>

    <section class="section section--soft one-cent-lessons" aria-labelledby="one-cent-lessons-title">
      <div class="shell one-cent-lessons__grid">
        <div data-reveal>
          <p class="eyebrow">小さな金額から見つけた実際の抜け</p>
          <h2 id="one-cent-lessons-title">たかが1セント。<br />されど1セント。</h2>
        </div>
        <div class="one-cent-lessons__list" data-reveal>
          <article><span>01</span><h3>金額の大小と、異常の重要度を分ける。</h3><p>1セントでも、説明できない変化なら確認する価値があります。</p></article>
