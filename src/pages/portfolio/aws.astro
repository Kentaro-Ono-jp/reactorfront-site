---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articleReadingMinutes } from "../../reading-times";

const portfolioCommit = "708056f33d56f1affe2dbe8e1b58f4a722895b88";

const journey = [
  {
    number: "01",
    verb: "Authenticate",
    title: "非管理者IAMユーザーで認証する",
    body: "日常作業ではAdministratorAccessを使わず、直接のリソース操作権限を持たないIAMプリンシパルから開始します。",
  },
  {
    number: "02",
    verb: "Assume",
    title: "用途別のIAM Roleを引き受ける",
    body: "設定閲覧、コスト確認、デプロイの用途ごとにロールを分け、STSの一時クレデンシャルへ切り替えます。",
  },
  {
    number: "03",
    verb: "Apply",
    title: "Terraformで一時環境を構築する",
    body: "ネットワーク、ECS、Cognito、RDS、S3、Amazon MQなどをバージョン管理したIaCから構築します。",
  },
  {
    number: "04",
    verb: "Test",
    title: "認証付きE2Eを実行する",
    body: "外部HTTPSからログイン、PDF登録、非同期推論、Human-in-the-loopのレビュー、監査証跡までを通します。",
  },
  {
    number: "05",
    verb: "Observe",
    title: "AWS状態とログを照合する",
    body: "画面上の成功だけで判定せず、サービス状態、アプリケーションログ、workflow summaryを確認します。",
  },
  {
    number: "06",
    verb: "Destroy",
    title: "撤収後に残存リソースを検査する",
    body: "terraform destroy後に27カテゴリを別経路で棚卸しし、一時リソースと実行データの残存ゼロを確認します。",
  },
];

const e2eSteps = [
  { label: "Login", title: "Cognito認証", body: "試験専用ユーザーでトークンを取得します。" },
  { label: "Upload", title: "PDF登録", body: "公開可能な合成文書をオブジェクトストレージへ登録します。" },
  { label: "Queue", title: "非同期配送", body: "Outboxからキューへ処理依頼が配送されることを確認します。" },
  { label: "ML", title: "ML推論", body: "Workerが採用済みModelで文書を分類します。" },
  { label: "Review", title: "Human Review", body: "推論結果を承認または訂正します。" },
  { label: "Audit", title: "Audit Trail", body: "推論と人の判断が別の監査証跡として保存されることを確認します。" },
];

const failureLessons = [
  {
    number: "01",
    title: "同じファイルでも、名前が違えば検証は止まる",
    body: "ダウンロードしたTerraformのファイル名と、検証側が期待した名前が一致せず、自動片付けが開始前に停止しました。",
    lesson: "中身だけでなく、受け渡しの約束まで固定する。",
  },
  {
    number: "02",
    title: "入っているPythonと、実際に選ばれるPythonは別物",
    body: "CodeBuildには目的の版があっても、実行時には別のPythonが先に選ばれました。",
    lesson: "『存在する』ではなく『実際に使われた』を確認する。",
  },
  {
    number: "03",
    title: "削除権限だけでは、安全な削除はできない",
    body: "片付け担当が、対象を特定するための小さな管理記録を読めずに止まりました。",
    lesson: "消す権限と、正しく対象を確かめる権限をセットで考える。",
  },
];

const references = [
  {
    label: "Portfolio source",
    title: "確認した公開コミット",
    href: `https://github.com/Kentaro-Ono-jp/Portfolio/commit/${portfolioCommit}`,
    note: "2026年8月14日時点のmainと一致",
  },
  {
    label: "Portfolio guide",
    title: "AWS Operations Guide（英語）",
    href: `https://github.com/Kentaro-Ono-jp/Portfolio/blob/${portfolioCommit}/AWS_OPERATIONS_GUIDE.md`,
    note: "設計・検証記録の一次資料",
  },
  {
    label: "AWS official",
    title: "ECSのFargateとEC2",
    href: "https://docs.aws.amazon.com/AmazonECS/latest/developerguide/capacity-launch-type-comparison.html",
    note: "実行基盤の違いに関するAWS公式説明",
  },
  {
    label: "AWS official",
    title: "AWS Fargateの料金",
    href: "https://aws.amazon.com/fargate/pricing/",
    note: "タスクの利用時間に基づくAWS公式料金",
  },
  {
    label: "AWS official",
    title: "Amazon MQの料金",
    href: "https://aws.amazon.com/amazon-mq/pricing/",
    note: "ブローカーと保存領域のAWS公式料金",
  },
  {
    label: "GitHub official",
    title: "GitHub Actionsの定期実行",
    href: "https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax#onschedule",
    note: "scheduleとタイムゾーンの公式仕様",
  },
  {
    label: "GitHub official",
    title: "AWSとOIDCで安全につなぐ",
    href: "https://docs.github.com/en/actions/how-tos/secure-your-work/security-harden-deployments/oidc-in-aws",
    note: "長期アクセスキーを置かない公式ガイド",
  },
  {
    label: "AWS official",
    title: "SchedulerからCodeBuildを起動する",
    href: "https://docs.aws.amazon.com/scheduler/latest/UserGuide/managing-targets-templated.html",
    note: "自動片付けの非常経路に使うAWS公式仕様",
  },
  {
    label: "AWS official",
    title: "予期しない請求を理解する",
    href: "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/checklistforunwantedcharges.html",
    note: "消した後も請求が残る代表例と確認方法",
  },
  {
    label: "AWS official",
    title: "IAMロールと一時的な権限",
    href: "https://docs.aws.amazon.com/IAM/latest/UserGuide/id_credentials_temp_control-access_assumerole.html",
    note: "AWS公式ドキュメント",
  },
  {
    label: "AWS official",
    title: "Permissions Boundary",
    href: "https://docs.aws.amazon.com/IAM/latest/UserGuide/access_policies_boundaries.html",
    note: "権限の上限に関するAWS公式説明",
  },
  {
    label: "AWS official",
    title: "CloudWatch Logsとは",
    href: "https://docs.aws.amazon.com/AmazonCloudWatch/latest/logs/WhatIsCloudWatchLogs.html",
    note: "ログの保存・検索に関するAWS公式説明",
  },
  {
    label: "HashiCorp official",
    title: "Terraform destroy",
    href: "https://developer.hashicorp.com/terraform/cli/commands/destroy",
    note: "Terraform公式リファレンス",
  },
];
---

<BaseLayout
  title={`AWSデプロイと撤収｜約${articleReadingMinutes.aws}分で読むポートフォリオ`}
  description="IAM、OIDC、Terraform、ECS/Fargate、認証付きE2E、CloudWatch Logs、destroy後の残存確認。ReactorFront Portfolioの実AWS検証を解説します。"
>
  <article class="aws-story">
    <header class="page-hero page-hero--aws-story">
      <div class="aws-story__orbit" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <div class="shell page-hero__inner">
        <div class="breadcrumbs" aria-label="パンくずリスト">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/portfolio/">Portfolio</a><span aria-hidden="true">/</span>
          <span>AWS behind the scenes</span>
        </div>
        <div class="page-hero__grid">
          <div>
            <p class="eyebrow eyebrow--accent">{articleReadingMinutes.aws}-minute field note</p>
            <h1>AWSを構築し、<br />E2E後に撤収する。</h1>
          </div>
          <div class="page-hero__lead">
            <p>
              Terraformで実AWS環境を構築し、認証付きE2Eとログで動作を確認し、destroy後の残存リソースまで検査する。
              ReactorFront Portfolioで実行した一連の検証を解説します。
            </p>
            <span class="reading-time">約{articleReadingMinutes.aws}分で読めます</span>
          </div>
        </div>
      </div>
    </header>

    <div class="story-meta">
      <div class="shell story-meta__inner">
        <div><span>Audience</span><strong>IT業界・クラウド運用に関心のある方</strong></div>
        <div><span>AWS checked</span><strong>2026.08.14</strong></div>
        <div><span>Portfolio main</span><strong><code>708056f</code></strong></div>
        <div><span>Format</span><strong>読み物 / 非チュートリアル</strong></div>
      </div>
    </div>

    <section class="section story-opening">
      <div class="shell story-opening__grid">
        <div data-reveal>
          <p class="eyebrow">What this story proves</p>
          <h2>構築、E2E、可観測性、<br />撤収をまとめて検証する。</h2>
        </div>
        <div class="prose prose--large" data-reveal>
          <p>
            このシステムは、Cognito、API Gateway、ECS/Fargate、RDS、S3、Amazon MQ、CloudWatch Logsなど、責務の異なるマネージドサービスで構成しています。
            デプロイとは、それらの依存関係とセキュリティ境界をIaCで再現する作業です。
          </p>
          <p>
            構築後は外部HTTPSからログイン、文書登録、非同期推論、Human-in-the-loopのレビュー、監査証跡までを通し、AWS側の状態とログを照合しました。
            E2E完了後は直ちに撤収し、Terraform stateだけに頼らずAWS APIから残存リソースを再確認しています。
          </p>
        </div>
      </div>

      <div class="scope-note shell" data-reveal>
        <span class="scope-note__icon" aria-hidden="true">i</span>
        <div>
          <h3>この記事は、AWSを再現するための手順書ではありません</h3>
          <p>
            実際のAWS設定と公開リポジトリを根拠にしていますが、コマンド、アカウント固有値、完全なIAMポリシー、環境変数、秘密情報は掲載しません。
            操作手順ではなく、権限設計、検証条件、コスト管理、障害復旧の判断を説明します。
          </p>
        </div>
      </div>

      <aside class="reader-bridge shell" data-reveal>
        <div class="reader-bridge__label">
          <span>理解の補助線</span>
          <strong>この章の全体像</strong>
        </div>
        <div>
          <h3>必要な時だけ、本番相当の環境を丸ごと作る話です。</h3>
          <p>
            AWS上にWeb画面、API、データベース、AI処理などを配置し、利用者と同じ流れで動作を確認した後、課金対象を片付けます。
            「作れた」「画面が開いた」だけで終わらず、「業務を最後まで通せた」「安全に閉じられた」までを一回の検証としています。
          </p>
          <p class="reader-bridge__meaning"><strong>実務上の意味</strong>公開作業だけでなく、試験、障害確認、費用の停止まで任せられることを示します。</p>
        </div>
      </aside>
    </section>

    <section class="section section--dark journey-section" id="journey">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow eyebrow--accent">One lifecycle</p>
            <h2>AuthenticateからDestroyまで、<br />同じWorkflowで管理する。</h2>
          </div>
          <p>
            デプロイやE2Eだけを個別の成功とは扱いません。事前の権限取得からpostflightの残存確認まで完走して、1回の検証完了とします。
          </p>
        </div>

        <ol class="aws-journey" aria-label="AWS実地試験の6段階">
          {
            journey.map((step) => (
              <li data-reveal>
                <div class="aws-journey__head">
                  <span>{step.number}</span><strong>{step.verb}</strong>
                </div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section iam-story" id="iam">
      <div class="shell iam-story__grid">
        <div class="iam-story__copy" data-reveal>
          <p class="eyebrow">IAM &amp; roles</p>
          <h2>Administrator権限を、<br />日常作業に使わない。</h2>
          <p>
            AWSアカウントの管理者と、日常作業に使うIAMプリンシパルを分離しています。
            非管理者IAMユーザーはリソースを直接操作せず、用途別のIAMロールをAssumeRoleして一時クレデンシャルを取得します。
          </p>
          <p>
            2026年8月14日の実環境確認では、作業用IAMユーザーがAssumeRoleできるのは参照専用、コスト参照、デプロイ操作の3ロールだけでした。
            デプロイ用ロールには1時間のセッション期限とPermissions Boundaryを設定しています。
          </p>
        </div>

        <figure class="permission-chain" data-reveal>
          <figcaption>IAM Userから用途別Roleへの権限遷移</figcaption>
          <div class="permission-chain__owner">
            <span class="permission-chain__label">Account administration</span>
            <strong>管理者Principal</strong>
            <small>初期構築・IAM保守・緊急対応</small>
          </div>
          <span class="permission-chain__arrow" aria-hidden="true">↓</span>
          <div class="permission-chain__entry">
            <span class="permission-chain__label">Entry principal</span>
            <strong>非管理者IAMユーザー</strong>
            <small>直接操作なし / sts:AssumeRoleのみ限定</small>
          </div>
          <span class="permission-chain__arrow" aria-hidden="true">↓</span>
          <div class="permission-chain__roles">
            <div>
              <span>01</span><strong>Read-only</strong><small>設定・状態・セキュリティ確認</small>
            </div>
            <div>
              <span>02</span><strong>Cost reader</strong><small>請求 / Cost Explorer参照</small>
            </div>
            <div class="permission-chain__role--operator">
              <span>03</span><strong>Deploy operator</strong><small>1時間の一時クレデンシャル</small>
              <em>Permission Boundary</em>
            </div>
          </div>
        </figure>
      </div>

      <div class="shell permission-facts" data-reveal>
        <article>
          <span>Role</span>
          <h3>STSで一時クレデンシャルを発行する</h3>
          <p>IAMユーザーへ強い権限を常設せず、ロールセッション中だけ必要な権限を付与します。</p>
        </article>
        <article>
          <span>Trust</span>
          <h3>信頼ポリシーでAssumeRole元を限定する</h3>
          <p>呼び出し元のポリシーだけでなく、ロール側の信頼ポリシーでも許可するプリンシパルを限定します。</p>
        </article>
        <article>
          <span>Boundary</span>
          <h3>Permissions Boundaryで上限を固定する</h3>
          <p>デプロイ用ロールは、アイデンティティポリシーとBoundaryの両方が許可するアクションだけを実行できます。</p>
        </article>
      </div>

      <aside class="reader-bridge shell" data-reveal>
        <div class="reader-bridge__label">
          <span>理解の補助線</span>
          <strong>IAMを平たく言うと</strong>
        </div>
        <div>
          <h3>万能鍵を持ち歩かず、用事ごとに期限付きの鍵を借ります。</h3>
          <p>
            普段使う利用者には強い権限を置かず、設定を見る時、費用を見る時、環境を作る時で別のロールへ切り替えます。
            デプロイの鍵は一時間で失効し、許可できる範囲にも上限を設けています。
          </p>
          <p class="reader-bridge__meaning"><strong>実務上の意味</strong>操作ミスや認証情報の流出が起きた場合でも、使える時間と影響範囲を狭くできます。</p>
        </div>
      </aside>
    </section>

    <section class="section section--soft deployment-story" id="deploy">
      <div class="shell">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">Deploy</p>
          <h2>AWSのマネージドサービスへ、<br />責務を分割して配置する。</h2>
          <p>
            Terraformモジュールで各サービスの構成と依存関係を定義し、同じコミットから検証環境を再構築できます。
          </p>
        </div>

        <div class="cloud-role-map" data-reveal>
          <article>
            <span>Ingress</span><h3>HTTPS Routing</h3><p>外部HTTPSを受け付け、WebとAPIのservice discoveryへ接続する。</p><small>API Gateway / Cloud Map</small>
          </article>
          <article>
            <span>Identity</span><h3>Authentication</h3><p>ユーザー認証とトークン発行を担当し、APIの認可情報へ接続する。</p><small>Cognito</small>
          </article>
          <article>
            <span>Runtime</span><h3>Container Services</h3><p>Web、API、MLワーカーを独立したタスク定義とECSサービスで実行する。</p><small>ECS / Fargate</small>
          </article>
          <article>
            <span>Messaging</span><h3>Asynchronous Queue</h3><p>APIとMLワーカーを分離し、長時間処理の配送と再試行を管理する。</p><small>Amazon MQ</small>
          </article>
          <article>
            <span>State</span><h3>Database / Object Storage</h3><p>業務状態と監査ログはRDS、PDFとアーティファクトはS3へ分離して保存する。</p><small>RDS / S3</small>
          </article>
          <article>
            <span>Observability</span><h3>Centralized Logs</h3><p>各コンテナとbuildのログを集約し、workflow IDから処理を追跡する。</p><small>CloudWatch Logs</small>
          </article>
        </div>

        <div class="runtime-choice" data-reveal>
          <div class="runtime-choice__lead">
            <p class="eyebrow">Why Fargate</p>
            <h3>短命な検証環境に、<br />サーバーレスコンテナを使う。</h3>
            <p>
              Web、API、MLワーカーのコンテナ分割を実AWSでも維持し、EC2インスタンスのプロビジョニングやOS保守を検証対象から外すため、ECS/Fargateを選びました。E2E完了後に実行環境をまとめて撤収しやすいことも判断理由です。
            </p>
          </div>
          <div class="runtime-choice__comparison">
            <article>
              <span>EC2で考えると</span>
              <strong>EC2キャパシティを管理する</strong>
              <p>台数、インスタンスタイプ、OSパッチ、ECS agent、キャパシティ不足時のスケーリングを設計・運用します。</p>
            </article>
            <article class="runtime-choice__selected">
              <span>Fargateで考えると</span>
              <strong>タスク単位でCPUとメモリを指定する</strong>
              <p>タスク定義にリソースを記述し、検証時だけコンテナを起動します。短命な環境の構築・撤収へ集中できます。</p>
            </article>
          </div>
          <p class="runtime-choice__boundary">
            Fargateが常時稼働で常に最安という主張ではありません。EC2キャパシティ管理を対象外とし、build・E2E・destroyのライフサイクル検証へ集中するための選択です。
          </p>
        </div>

        <aside class="reader-bridge" data-reveal>
          <div class="reader-bridge__label">
            <span>理解の補助線</span>
            <strong>Fargateを選ぶ意味</strong>
          </div>
          <div>
            <h3>サーバーそのものの保守を減らし、アプリの検証へ集中します。</h3>
            <p>
              EC2では仮想サーバーの台数、OS更新、空き容量なども管理対象になります。Fargateでは必要なCPUとメモリを指定し、検証する間だけコンテナを実行できます。
              今回はサーバー運用の比較ではなく、アプリケーションを配置して片付ける工程を確かめるため、この方式を選びました。
            </p>
            <p class="reader-bridge__meaning"><strong>実務上の意味</strong>何を検証し、何をAWSへ任せるかを明確にし、短命な環境の構築と撤収へ作業を絞れます。</p>
          </div>
        </aside>
      </div>
    </section>

    <section class="section cost-story" id="cost">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow">Cost is architecture</p>
            <h2>常時稼働ではなく、<br />月次のEphemeral Environmentにする。</h2>
          </div>
          <p>
            このAWS環境は公開サービスではなく、デプロイ可能性、認証付きE2E、可観測性、撤収能力を定期確認するための検証環境です。
          </p>
        </div>

        <div class="cost-story__grid">
          <figure class="cost-observation" data-reveal>
            <figcaption>
              <span>Observed / AWS Cost Explorer</span>
              <strong>5回のデプロイ試行を中心に、当月ここまで$2.40。</strong>
            </figcaption>
            <a class="cost-observation__screen" href="/images/aws-cost-explorer-2026-08-14.png" target="_blank" rel="noreferrer" aria-label="AWS Cost Explorerの元画面を原寸で見る">
              <span class="cost-observation__crop">
                <img
                  src="/images/aws-cost-explorer-2026-08-14.png"
                  width="1078"
                  height="464"
                  loading="lazy"
                  decoding="async"
