---
import BaseLayout from "../../layouts/BaseLayout.astro";

const portfolioCommit = "708056f33d56f1affe2dbe8e1b58f4a722895b88";

const journey = [
  {
    number: "01",
    verb: "入る",
    title: "本人確認をする",
    body: "まずAWSへ入る人を特定します。普段の作業に、管理者の強い権限は使いません。",
  },
  {
    number: "02",
    verb: "借りる",
    title: "作業用の権限へ切り替える",
    body: "その仕事に必要な時間だけ、用途を限定したロール（作業許可証）を借ります。",
  },
  {
    number: "03",
    verb: "つくる",
    title: "設計図から環境を組み立てる",
    body: "Terraformという設計図を使い、ネットワーク、画面、処理、データ保存を配置します。",
  },
  {
    number: "04",
    verb: "試す",
    title: "利用者の流れを端から端まで通す",
    body: "ログインからPDF登録、AI処理、人の確認、監査記録までを一続きで確かめます。",
  },
  {
    number: "05",
    verb: "読む",
    title: "状態とログで裏を取る",
    body: "画面が開くだけで合格にはせず、AWSの状態と処理記録も照合します。",
  },
  {
    number: "06",
    verb: "消す",
    title: "片付けた後も残骸を探す",
    body: "destroy後にもう一度AWSを調べ、課金対象や一時データが残っていないことまで技術的に証明します。",
  },
];

const e2eSteps = [
  { label: "Login", title: "本人として入る", body: "試験専用の利用者でログインします。" },
  { label: "Upload", title: "PDFを預ける", body: "公開可能な合成文書だけを登録します。" },
  { label: "Queue", title: "裏方へ渡す", body: "処理依頼が失われず、次の担当へ届くか見ます。" },
  { label: "ML", title: "AIが候補を返す", body: "別の処理係が文書の種類を予測します。" },
  { label: "Review", title: "人が最終判断する", body: "予測を承認または訂正します。" },
  { label: "Audit", title: "経緯を追える", body: "機械と人の判断が記録に残ることを確かめます。" },
];

const failureLessons = [
  {
    number: "01",
    title: "同じファイルでも、名前が違えば検証は止まる",
    body: "ダウンロードしたTerraformのファイル名と、検証側が期待した名前が一致せず、自動片付けが開始前に停止しました。",
    lesson: "中身だけでなく、受け渡しの約束まで固定する。",
  },
  {
    number: "02",
    title: "入っているPythonと、実際に選ばれるPythonは別物",
    body: "CodeBuildには目的の版があっても、実行時には別のPythonが先に選ばれました。",
    lesson: "『存在する』ではなく『実際に使われた』を確認する。",
  },
  {
    number: "03",
    title: "削除権限だけでは、安全な削除はできない",
    body: "片付け担当が、対象を特定するための小さな管理記録を読めずに止まりました。",
    lesson: "消す権限と、正しく対象を確かめる権限をセットで考える。",
  },
];

const references = [
  {
    label: "Portfolio source",
    title: "確認した公開コミット",
    href: `https://github.com/Kentaro-Ono-jp/Portfolio/commit/${portfolioCommit}`,
    note: "2026年8月14日時点のmainと一致",
  },
  {
    label: "Portfolio guide",
    title: "AWS Operations Guide（英語）",
    href: `https://github.com/Kentaro-Ono-jp/Portfolio/blob/${portfolioCommit}/AWS_OPERATIONS_GUIDE.md`,
    note: "設計・検証記録の一次資料",
  },
  {
    label: "AWS official",
    title: "ECSのFargateとEC2",
    href: "https://docs.aws.amazon.com/AmazonECS/latest/developerguide/capacity-launch-type-comparison.html",
    note: "実行基盤の違いに関するAWS公式説明",
  },
  {
    label: "AWS official",
    title: "AWS Fargateの料金",
    href: "https://aws.amazon.com/fargate/pricing/",
    note: "タスクの利用時間に基づくAWS公式料金",
  },
  {
    label: "AWS official",
    title: "Amazon MQの料金",
    href: "https://aws.amazon.com/amazon-mq/pricing/",
    note: "ブローカーと保存領域のAWS公式料金",
  },
  {
    label: "GitHub official",
    title: "GitHub Actionsの定期実行",
    href: "https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax#onschedule",
    note: "scheduleとタイムゾーンの公式仕様",
  },
  {
    label: "GitHub official",
    title: "AWSとOIDCで安全につなぐ",
    href: "https://docs.github.com/en/actions/how-tos/secure-your-work/security-harden-deployments/oidc-in-aws",
    note: "長期アクセスキーを置かない公式ガイド",
  },
  {
    label: "AWS official",
    title: "SchedulerからCodeBuildを起動する",
    href: "https://docs.aws.amazon.com/scheduler/latest/UserGuide/managing-targets-templated.html",
    note: "自動片付けの非常経路に使うAWS公式仕様",
  },
  {
    label: "AWS official",
    title: "予期しない請求を理解する",
    href: "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/checklistforunwantedcharges.html",
    note: "消した後も請求が残る代表例と確認方法",
  },
  {
    label: "AWS official",
    title: "IAMロールと一時的な権限",
    href: "https://docs.aws.amazon.com/IAM/latest/UserGuide/id_credentials_temp_control-access_assumerole.html",
    note: "AWS公式ドキュメント",
  },
  {
    label: "AWS official",
    title: "Permissions Boundary",
    href: "https://docs.aws.amazon.com/IAM/latest/UserGuide/access_policies_boundaries.html",
    note: "権限の上限に関するAWS公式説明",
  },
  {
    label: "AWS official",
    title: "CloudWatch Logsとは",
    href: "https://docs.aws.amazon.com/AmazonCloudWatch/latest/logs/WhatIsCloudWatchLogs.html",
    note: "ログの保存・検索に関するAWS公式説明",
  },
  {
    label: "HashiCorp official",
    title: "Terraform destroy",
    href: "https://developer.hashicorp.com/terraform/cli/commands/destroy",
    note: "Terraform公式リファレンス",
  },
];
---

<BaseLayout
  title="AWSの舞台裏｜10分で読むポートフォリオ"
  description="ReactorFront Portfolioを実AWSへ配置し、E2Eで確かめ、ログを読み、destroy後の残存ゼロまで確認する流れを、非エンジニア向けにやさしく解説します。"
>
  <article class="aws-story">
    <header class="page-hero page-hero--aws-story">
      <div class="aws-story__orbit" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <div class="shell page-hero__inner">
        <div class="breadcrumbs" aria-label="パンくずリスト">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/portfolio/">Portfolio</a><span aria-hidden="true">/</span>
          <span>AWS behind the scenes</span>
        </div>
        <div class="page-hero__grid">
          <div>
            <p class="eyebrow eyebrow--accent">10-minute field note</p>
            <h1>つくるだけでは、<br />終われない。</h1>
          </div>
          <div class="page-hero__lead">
            <p>
              AWSへ載せる。利用者として試す。失敗の記録を読む。そして、料金が発生する環境を消し切る。
              ReactorFront Portfolioの実地試験を、少しだけ詳しく案内します。
            </p>
            <span class="reading-time">約10分で読めます</span>
          </div>
        </div>
      </div>
    </header>

    <div class="story-meta">
      <div class="shell story-meta__inner">
        <div><span>Audience</span><strong>非エンジニア・学習初期</strong></div>
        <div><span>AWS checked</span><strong>2026.08.14</strong></div>
        <div><span>Portfolio main</span><strong><code>708056f</code></strong></div>
        <div><span>Format</span><strong>読み物 / 非チュートリアル</strong></div>
      </div>
    </div>

    <section class="section story-opening">
      <div class="shell story-opening__grid">
        <div data-reveal>
          <p class="eyebrow">What this story proves</p>
          <h2>「動いた」の、<br />もう一歩先へ。</h2>
        </div>
        <div class="prose prose--large" data-reveal>
          <p>
            クラウドへのデプロイは、完成したファイルを一か所へ置く作業ではありません。
            受付、本人確認、処理係、データ置き場、連絡網など、役割の異なる仕組みをAWS上で組み合わせる仕事です。
          </p>
          <p>
            この作品では、短時間だけ実AWS環境を組み立て、ログインから文書処理、AIの予測、人の最終判断、監査記録までを確認しました。
            合格後はすぐに環境を片付け、Terraformの管理対象だけでなく、AWS側に残りやすいものまで別に数え直しています。
          </p>
        </div>
      </div>

      <div class="scope-note shell" data-reveal>
        <span class="scope-note__icon" aria-hidden="true">i</span>
        <div>
          <h3>この記事は、AWSを再現するための手順書ではありません</h3>
          <p>
            実際のAWS設定と公開リポジトリを根拠にしていますが、コマンド、アカウント固有値、完全なIAMポリシー、環境変数、秘密情報は掲載しません。
            読後に「何を、なぜ確かめたか」が分かる粒度に留めています。
          </p>
        </div>
      </div>
    </section>

    <section class="section section--dark journey-section" id="journey">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow eyebrow--accent">One lifecycle</p>
            <h2>入って、借りて、<br />つくって、消す。</h2>
          </div>
          <p>
            実AWSの試験は一本道です。途中だけ成功しても、最後の片付けまで通らなければ完了とは扱いません。
          </p>
        </div>

        <ol class="aws-journey" aria-label="AWS実地試験の6段階">
          {
            journey.map((step) => (
              <li data-reveal>
                <div class="aws-journey__head">
                  <span>{step.number}</span><strong>{step.verb}</strong>
                </div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section iam-story" id="iam">
      <div class="shell iam-story__grid">
        <div class="iam-story__copy" data-reveal>
          <p class="eyebrow">IAM &amp; roles</p>
          <h2>強い鍵を、<br />持ち歩かない。</h2>
          <p>
            IAMは「誰が、何をしてよいか」を決める仕組みです。
            ReactorFrontの実環境では、全体を管理する権限と、日常の確認・配置に使う権限を分けています。
          </p>
          <p>
            2026年8月14日の管理画面確認では、管理者権限を持たない作業用IAMユーザーにはAWS資源を直接操作する権限がなく、
            指定された3種類のロールだけを借りられる構成でした。
          </p>
        </div>

        <figure class="permission-chain" data-reveal>
          <figcaption>入館証と作業許可証で考える権限の流れ</figcaption>
          <div class="permission-chain__owner">
            <span class="permission-chain__label">責任者</span>
            <strong>オーナー管理者</strong>
            <small>初期整備・保守・全体確認</small>
          </div>
          <span class="permission-chain__arrow" aria-hidden="true">↓</span>
          <div class="permission-chain__entry">
            <span class="permission-chain__label">入館証</span>
            <strong>作業用IAMユーザー</strong>
            <small>直接の作業権限なし / 借り先だけを限定</small>
          </div>
          <span class="permission-chain__arrow" aria-hidden="true">↓</span>
          <div class="permission-chain__roles">
            <div>
              <span>01</span><strong>観察する</strong><small>設定と安全性を読む</small>
            </div>
            <div>
              <span>02</span><strong>費用を見る</strong><small>請求・利用量を読む</small>
            </div>
            <div class="permission-chain__role--operator">
              <span>03</span><strong>配置・試験・片付け</strong><small>1時間の作業許可証</small>
              <em>Permission Boundary</em>
            </div>
          </div>
        </figure>
      </div>

      <div class="shell permission-facts" data-reveal>
        <article>
          <span>Role</span>
          <h3>ロールは、借りる権限</h3>
          <p>入口の権限を強くするのではなく、作業中だけ別の許可証へ切り替えます。</p>
        </article>
        <article>
          <span>Trust</span>
          <h3>貸す側も、相手を確認する</h3>
          <p>入口が「借りたい」と言えるだけでなく、ロール側も「この入口へ貸してよい」と定めます。</p>
        </article>
        <article>
          <span>Boundary</span>
          <h3>許可の上限を、別に置く</h3>
          <p>配置ロールは、付与ポリシーと上限ポリシーの両方が許す範囲だけで動きます。</p>
        </article>
      </div>
    </section>

    <section class="section section--soft deployment-story" id="deploy">
      <div class="shell">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">Deploy</p>
          <h2>一つの作品を、<br />複数の専門部署へ分ける。</h2>
          <p>
            Terraformは「どの部署を、どう結ぶか」を記した設計図です。実AWSでは、次のような役割へ分けて配置しました。
          </p>
        </div>

        <div class="cloud-role-map" data-reveal>
          <article>
            <span>Front door</span><h3>受付</h3><p>外からのHTTPS通信を受け、WebとAPIへ安全につなぐ。</p><small>API Gateway / Cloud Map</small>
          </article>
          <article>
            <span>Identity</span><h3>本人確認</h3><p>ログインした人と、許可された操作を見分ける。</p><small>Cognito</small>
          </article>
          <article>
            <span>Runtime</span><h3>働く場所</h3><p>Web、司令塔のAPI、AI処理係を別々に動かす。</p><small>ECS / Fargate</small>
          </article>
          <article>
            <span>Handoff</span><h3>仕事の連絡網</h3><p>重い処理を待ち行列へ渡し、途中で失わない。</p><small>Amazon MQ</small>
          </article>
          <article>
            <span>State</span><h3>記録と文書</h3><p>業務状態とPDFを、役割の異なる保存先へ分ける。</p><small>RDS / S3</small>
          </article>
          <article>
            <span>Evidence</span><h3>観測</h3><p>各担当の状態と記録を集め、失敗箇所を追えるようにする。</p><small>CloudWatch Logs</small>
          </article>
        </div>

        <div class="runtime-choice" data-reveal>
          <div class="runtime-choice__lead">
            <p class="eyebrow">Why Fargate</p>
            <h3>常設サーバーを持たず、<br />仕事だけを起動する。</h3>
            <p>
              この作品はWeb、API、AI処理を3つのコンテナに分けています。その分担を実AWSでも保ちつつ、短時間の試験が終われば丸ごと止めやすいことから、ECSのFargateを選びました。
            </p>
          </div>
          <div class="runtime-choice__comparison">
            <article>
              <span>EC2で考えると</span>
              <strong>先に「サーバー」を用意する</strong>
              <p>台数、容量、OS、更新、コンテナを載せる余白まで、自分たちで面倒を見る領域が増えます。</p>
            </article>
            <article class="runtime-choice__selected">
              <span>Fargateで考えると</span>
              <strong>必要な「仕事」を渡す</strong>
              <p>使うCPUとメモリを決めてコンテナを起動し、実証後はタスクと環境を片付けます。短命な使い方と相性がよい選択でした。</p>
            </article>
          </div>
          <p class="runtime-choice__boundary">
            Fargateを「常時稼働で必ず最安の方式」として選んだわけではありません。サーバーの維持を作品の目的にせず、作る・試す・消すという実証へ集中するための判断です。
          </p>
        </div>
      </div>
    </section>

    <section class="section cost-story" id="cost">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow">Cost is architecture</p>
            <h2>見せるために、<br />24時間は動かさない。</h2>
          </div>
          <p>
            このAWS環境の目的は、常時サービスを提供することではありません。実際に配置でき、利用者の流れを試せ、最後まで片付けられることを証明するための試験場です。
          </p>
        </div>

        <div class="cost-story__grid">
          <figure class="cost-observation" data-reveal>
            <figcaption>
              <span>Observed / AWS Cost Explorer</span>
              <strong>5回のデプロイ試行を中心に、当月ここまで$2.40。</strong>
            </figcaption>
            <a class="cost-observation__screen" href="/images/aws-cost-explorer-2026-08-14.png" target="_blank" rel="noreferrer" aria-label="AWS Cost Explorerの元画面を原寸で見る">
              <span class="cost-observation__crop">
                <img
                  src="/images/aws-cost-explorer-2026-08-14.png"
                  width="1078"
                  height="464"
                  loading="lazy"
                  decoding="async"
                  alt="2026年8月のAWS Cost Explorerをサービス別に表示した画面。内訳はAmazon MQ 1.57ドル、Amazon Elastic Container Service 0.29ドル、税0.22ドル、Amazon Relational Database Service 0.14ドル、CodeBuild 0.08ドル、その他0.11ドル。"
                />
              </span>
              <span class="cost-observation__open">元画面を原寸で見る <em aria-hidden="true">↗</em></span>
            </a>
            <a class="run-accounting" href="https://github.com/Kentaro-Ono-jp/Portfolio/actions/workflows/aws-deploy.yml" target="_blank" rel="noreferrer" aria-label="GitHub ActionsのAWSデプロイ実行履歴を見る">
              <div><span>Actions起動</span><strong>8</strong></div>
              <i aria-hidden="true">−</i>
              <div><span>作成前に停止</span><strong>3</strong></div>
              <i aria-hidden="true">＝</i>
              <div class="run-accounting__primary"><span>デプロイ試行</span><strong>5</strong></div>
              <small>途中失敗 3 / 全工程完走 2 <em aria-hidden="true">↗</em></small>
            </a>
            <p class="cost-observation__note">
              所有者のCost Explorerを読み取り専用で確認した値です。Actions外の実地検証、片付け経路の調整、意図的に残す管理基盤、税、Cost Explorer自身の$0.03も含みます。照会回数は断定せず、アカウント識別子や生の管理画面は公開しません。
            </p>
          </figure>

          <div class="cost-decisions">
            <article data-reveal>
              <span>01 / Measure</span>
              <h3>「何回」を、記録から数える。</h3>
              <p>
                公開されたActions記録は8回。そのうちAWS配置の工程へ到達した5回だけをデプロイ試行と数えました。3回は途中失敗後もdestroyと残存確認に成功し、2回はE2Eまで含む全工程を完走しています。
              </p>
            </article>
            <article data-reveal>
              <span>02 / Notice</span>
              <h3>一番大きかったのは、MQ。</h3>
              <p>
                短い実証でもAmazon MQだけで当月総額の約65%でした。本番向けの冗長化を足せばさらに増えます。作品の説明だけのために動かし続ける合理性はありません。
              </p>
            </article>
            <article data-reveal>
              <span>03 / Decide</span>
              <h3>必要な時だけ、全部を通す。</h3>
              <p>
                $2.40は24時間稼働の月額試算ではありません。料金が変わる将来額を断定せず、月に一度だけ環境を作り、E2Eを完走し、すぐに消す。可用性ではなく、ライフサイクル全体を繰り返せることへ費用を使います。
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--dark automation-story" id="automation">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow eyebrow--accent">Two clocks</p>
            <h2>月に一度の実地試験。<br />60分後の非常口。</h2>
          </div>
          <p>
            「定期的に作る時計」と「途中で止まっても消す時計」は別々です。一方の失敗で、高価な一時環境が置き去りにならないようにしています。
          </p>
        </div>

        <div class="automation-clocks">
          <article class="automation-clock automation-clock--monthly" data-reveal>
            <header>
