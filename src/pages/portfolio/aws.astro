---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ArticleCover from "../../components/ArticleCover.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articleReadingMinutes } from "../../reading-times";
import { getArticleRouteMetadata, SITE_URL } from "../../site-metadata";
import { createArticle, type BreadcrumbItem } from "../../structured-data";

const breadcrumbs = [
  { name: "ホーム", href: "/" },
  { name: "ポートフォリオ", href: "/portfolio/" },
  { name: "AWS環境の構築と撤収", href: "/portfolio/aws/" },
] satisfies BreadcrumbItem[];

const pageTitle = `AWS環境を構築・確認・撤収する工程｜約${articleReadingMinutes.aws}分で読む`;
const articleHeadline = "AWSで認証し、環境を構築・動作確認・撤収して、残存0件まで確かめる工程";
const articleDescription = "用途別の一時権限、Terraformによる構築、認証付きE2E、ログ確認、destroy、27カテゴリの残存検査まで。ReactorFront（リアクターフロント）の実AWS検証を解説します。";
const articleMetadata = getArticleRouteMetadata("/portfolio/aws/");
const canonical = new URL(articleMetadata.path, SITE_URL).href;
const representativeImagePath = "/images/article-aws-lifecycle.webp";
const representativeImage = new URL(representativeImagePath, canonical).href;
const representativeImageAlt = "一時権限の取得、AWS環境の構築、利用者操作の試験、ログ確認、撤収、残存検査を結ぶ工程図";
const { datePublished, lastModified: dateModified } = articleMetadata;
const articleSchema = createArticle({
  canonical,
  headline: articleHeadline,
  description: articleDescription,
  images: [representativeImage],
  datePublished,
  dateModified,
});

const portfolioCommit = "708056f33d56f1affe2dbe8e1b58f4a722895b88";

const journey = [
  {
    number: "01",
    verb: "認証",
    title: "日常作業用のIAMユーザーで本人を確認する",
    body: "日常作業ではAdministratorAccessを使わず、AWSリソースを直接操作する権限を持たないIAMユーザーから開始します。",
  },
  {
    number: "02",
    verb: "権限切替",
    title: "用途別のIAM Roleへ一時的に切り替える",
    body: "設定閲覧、費用確認、環境構築の用途ごとにRoleを分け、STSが発行する期限付きの認証情報へ切り替えます。",
  },
  {
    number: "03",
    verb: "構築",
    title: "Terraformで一時環境を構築する",
    body: "ネットワーク、ECS、Cognito、RDS、S3、Amazon MQなどを、コードで構成を管理するIaCから構築します。",
  },
  {
    number: "04",
    verb: "動作確認",
    title: "認証から監査までの利用者操作を通す",
    body: "外部HTTPSからログイン、PDF登録、非同期推論、人による確認、監査記録までを端から端まで試すE2Eを実行します。",
  },
  {
    number: "05",
    verb: "証拠確認",
    title: "AWSの状態とログで結果を確かめる",
    body: "画面上の成功だけで判定せず、serviceの状態、アプリケーションlog、workflowの実行要約を確認します。",
  },
  {
    number: "06",
    verb: "撤収・残存検査",
    title: "環境を撤収し、残り物がないか別経路で調べる",
    body: "terraform destroy後に27カテゴリをAWS APIで別に棚卸しし、一時リソースと実行データの残存0件を確認します。",
  },
];

const e2eSteps = [
  { label: "ログイン", title: "Cognito認証", body: "試験専用ユーザーでtokenを取得します。" },
  { label: "PDF登録", title: "合成文書を保存", body: "公開可能な合成文書をファイル保存領域へ登録します。" },
  { label: "処理依頼", title: "非同期配送", body: "Outboxからqueueへ処理依頼が配送されることを確認します。" },
  { label: "ML", title: "文書を分類", body: "MLワーカーが採用済みモデルで文書を分類します。" },
  { label: "人の確認", title: "推論結果を確認", body: "利用者が推論結果を承認または訂正します。" },
  { label: "監査記録", title: "機械と人の判断を保存", body: "推論と人の判断が別の監査記録として保存されることを確認します。" },
];

const failureLessons = [
  {
    number: "01",
    title: "同じファイルでも、名前が違えば検証は止まる",
    body: "ダウンロードしたTerraformのファイル名と、検証側が期待した名前が一致せず、自動片付けが開始前に停止しました。",
    lesson: "中身だけでなく、受け渡しの約束まで固定する。",
  },
  {
    number: "02",
    title: "入っているPythonと、実際に選ばれるPythonは別物",
    body: "CodeBuildには目的の版があっても、実行時には別のPythonが先に選ばれました。",
    lesson: "『存在する』ではなく『実際に使われた』を確認する。",
  },
  {
    number: "03",
    title: "削除権限だけでは、安全な削除はできない",
    body: "片付け担当が、対象を特定するための小さな管理記録を読めずに止まりました。",
    lesson: "消す権限と、正しく対象を確かめる権限をセットで考える。",
  },
];

const references = [
  {
    label: "Portfolioの実装",
    title: "確認した公開コミット",
    href: `https://github.com/Kentaro-Ono-jp/Portfolio/commit/${portfolioCommit}`,
    note: "2026年8月14日時点のmainと一致",
  },
  {
    label: "Portfolioの運用記録",
    title: "AWS Operations Guide（英語）",
    href: `https://github.com/Kentaro-Ono-jp/Portfolio/blob/${portfolioCommit}/AWS_OPERATIONS_GUIDE.md`,
    note: "設計・検証記録の一次資料",
  },
  {
    label: "AWS公式資料",
    title: "ECSのFargateとEC2",
    href: "https://docs.aws.amazon.com/AmazonECS/latest/developerguide/capacity-launch-type-comparison.html",
    note: "実行基盤の違いに関するAWS公式説明",
  },
  {
    label: "AWS公式資料",
    title: "AWS Fargateの料金",
    href: "https://aws.amazon.com/fargate/pricing/",
    note: "タスクの利用時間に基づくAWS公式料金",
  },
  {
    label: "AWS公式資料",
    title: "Amazon MQの料金",
    href: "https://aws.amazon.com/amazon-mq/pricing/",
    note: "ブローカーと保存領域のAWS公式料金",
  },
  {
    label: "GitHub公式資料",
    title: "GitHub Actionsの定期実行",
    href: "https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax#onschedule",
    note: "scheduleとタイムゾーンの公式仕様",
  },
  {
    label: "GitHub公式資料",
    title: "AWSとOIDCで安全につなぐ",
    href: "https://docs.github.com/en/actions/how-tos/secure-your-work/security-harden-deployments/oidc-in-aws",
    note: "長期アクセスキーを置かない公式ガイド",
  },
  {
    label: "AWS公式資料",
    title: "SchedulerからCodeBuildを起動する",
    href: "https://docs.aws.amazon.com/scheduler/latest/UserGuide/managing-targets-templated.html",
    note: "自動片付けの非常経路に使うAWS公式仕様",
  },
  {
    label: "AWS公式資料",
    title: "予期しない請求を理解する",
    href: "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/checklistforunwantedcharges.html",
    note: "消した後も請求が残る代表例と確認方法",
  },
  {
    label: "AWS公式資料",
    title: "IAMロールと一時的な権限",
    href: "https://docs.aws.amazon.com/IAM/latest/UserGuide/id_credentials_temp_control-access_assumerole.html",
    note: "AWS公式ドキュメント",
  },
  {
    label: "AWS公式資料",
    title: "Permissions Boundary",
    href: "https://docs.aws.amazon.com/IAM/latest/UserGuide/access_policies_boundaries.html",
    note: "権限の上限に関するAWS公式説明",
  },
  {
    label: "AWS公式資料",
    title: "CloudWatch Logsとは",
    href: "https://docs.aws.amazon.com/AmazonCloudWatch/latest/logs/WhatIsCloudWatchLogs.html",
    note: "ログの保存・検索に関するAWS公式説明",
  },
  {
    label: "HashiCorp公式資料",
    title: "Terraform destroy",
    href: "https://developer.hashicorp.com/terraform/cli/commands/destroy",
    note: "Terraform公式リファレンス",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={articleDescription}
  image={representativeImagePath}
  imageAlt={representativeImageAlt}
  imageWidth={1536}
  imageHeight={1024}
  imageType="image/webp"
  breadcrumbs={breadcrumbs}
  structuredData={articleSchema}
>
  <article class="aws-story">
    <header class="page-hero page-hero--aws-story">
      <div class="aws-story__orbit" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <div class="shell page-hero__inner">
        <Breadcrumbs items={breadcrumbs} />
        <div class="page-hero__grid">
          <div>
            <p class="eyebrow eyebrow--accent">約{articleReadingMinutes.aws}分で分かる実AWS検証</p>
            <h1>認証して構築し、<br />動作確認後に撤収する。</h1>
          </div>
          <div class="page-hero__lead">
            <p>
              用途別の一時権限へ切り替え、Terraformで実AWS環境を構築し、認証から監査までのE2Eとlogで動作を確認する。さらにdestroy後も27カテゴリを調べ、残存0件を確かめます。
              ReactorFront（リアクターフロント）が公開するPortfolioで実行した一連の検証です。
            </p>
            <div class="article-byline" aria-label="記事情報">
              <span>著者 <a href="/profile/" rel="author">小野賢太郎</a></span>
              <span>公開 <time datetime={datePublished}>2026年8月14日</time></span>
              <span>最終更新 <time datetime={dateModified}>2026年8月23日</time></span>
            </div>
            <span class="reading-time">約{articleReadingMinutes.aws}分で読めます</span>
          </div>
        </div>
      </div>
    </header>

    <ArticleCover
      src={representativeImagePath}
      alt={representativeImageAlt}
      caption="一時権限の取得、環境構築、利用者操作の試験、log確認、撤収、残存検査を一続きの工程として扱う。"
    />

    <div class="story-meta">
      <div class="shell story-meta__inner">
        <div><span>想定読者</span><strong>IT業界・クラウド運用に関心のある方</strong></div>
        <div><span>AWS確認日</span><strong>2026.08.14</strong></div>
        <div><span>対象commit</span><strong><code>708056f</code></strong></div>
        <div><span>記事の位置づけ</span><strong>読み物 / 手順書ではない</strong></div>
      </div>
    </div>

    <section class="section story-opening">
      <div class="shell story-opening__grid">
        <div data-reveal>
          <p class="eyebrow">この記事で確認できること</p>
          <h2>環境構築、利用者操作、log、<br />撤収をまとめて検証する。</h2>
        </div>
        <div class="prose prose--large" data-reveal>
          <p>
            このシステムは、Cognito、API Gateway、ECS/Fargate、RDS、S3、Amazon MQ、CloudWatch Logsなど、担当する仕事が異なるAWS serviceで構成しています。
            環境構築では、それらの接続順と権限の境界を、コードで構成を管理するIaCから再現します。
          </p>
          <p>
            構築後は外部HTTPSからログイン、文書登録、非同期推論、人による確認、監査記録までを通し、AWS側の状態とlogを照合しました。
            E2E完了後は直ちに撤収し、Terraformの管理記録（state）だけに頼らずAWS APIから残存リソースを再確認しています。
          </p>
        </div>
      </div>

      <div class="scope-note shell" data-reveal>
        <span class="scope-note__icon" aria-hidden="true">i</span>
        <div>
          <h3>この記事は、AWSを再現するための手順書ではありません</h3>
          <p>
            実際のAWS設定と公開リポジトリを根拠にしていますが、コマンド、アカウント固有値、完全なIAMポリシー、環境変数、秘密情報は掲載しません。
            操作手順ではなく、権限設計、検証条件、コスト管理、障害復旧の判断を説明します。
          </p>
        </div>
      </div>

      <aside class="reader-bridge shell" data-reveal>
        <div class="reader-bridge__label">
          <span>理解の補助線</span>
          <strong>この章の全体像</strong>
        </div>
        <div>
          <h3>必要な時だけ、本番相当の環境を丸ごと作る話です。</h3>
          <p>
            AWS上にWeb画面、API、データベース、AI処理などを配置し、利用者と同じ流れで動作を確認した後、課金対象を片付けます。
            「作れた」「画面が開いた」だけで終わらず、「業務を最後まで通せた」「安全に閉じられた」までを一回の検証としています。
          </p>
          <p class="reader-bridge__meaning"><strong>実務上の意味</strong>公開作業だけでなく、試験、障害確認、費用の停止まで任せられることを示します。</p>
        </div>
      </aside>
    </section>

    <section class="section section--dark journey-section" id="journey">
      <div class="shell">
        <div class="section-heading section-heading--split" data-reveal>
          <div>
            <p class="eyebrow eyebrow--accent">認証から残存確認までの一連の工程</p>
            <h2>認証、構築、動作確認、撤収を、<br />同じworkflowで管理する。</h2>
          </div>
          <p>
            環境構築やE2Eだけを個別の成功とは扱いません。事前の権限取得から、撤収後に別経路で行う残存確認まで完走して、1回の検証完了とします。
          </p>
        </div>

        <ol class="aws-journey" aria-label="AWS実地試験の6段階">
          {
            journey.map((step) => (
              <li data-reveal>
                <div class="aws-journey__head">
                  <span>{step.number}</span><strong>{step.verb}</strong>
                </div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section iam-story" id="iam">
      <div class="shell iam-story__grid">
        <div class="iam-story__copy" data-reveal>
          <p class="eyebrow">用途別の一時権限と権限上限</p>
          <h2>Administrator権限を、<br />日常作業に使わない。</h2>
          <p>
            AWSへのアクセスを管理するIAMでは、アカウント管理者と日常作業用の利用者を分離しています。
            日常作業用のIAMユーザーはリソースを直接操作せず、用途別のIAM Roleへ切り替えるAssumeRoleを実行し、期限付きの認証情報を取得します。
          </p>
          <p>
            2026年8月14日の実環境確認では、作業用IAMユーザーがAssumeRoleできるのは設定参照、費用参照、環境構築の3 Roleだけでした。
            環境構築用Roleには1時間の利用期限と、許可できる権限の上限（Permissions Boundary）を設定しています。
          </p>
        </div>

        <figure class="permission-chain" data-reveal>
          <figcaption>日常作業用のIAM Userから用途別Roleへ一時的に切り替える流れ</figcaption>
          <div class="permission-chain__owner">
            <span class="permission-chain__label">アカウント管理</span>
            <strong>管理者</strong>
            <small>初期構築・IAM保守・緊急対応</small>
          </div>
          <span class="permission-chain__arrow" aria-hidden="true">↓</span>
          <div class="permission-chain__entry">
            <span class="permission-chain__label">作業開始時の利用者</span>
            <strong>非管理者IAMユーザー</strong>
            <small>直接操作なし / sts:AssumeRoleのみ限定</small>
          </div>
          <span class="permission-chain__arrow" aria-hidden="true">↓</span>
          <div class="permission-chain__roles">
            <div>
              <span>01</span><strong>設定参照（Read-only）</strong><small>設定・状態・セキュリティ確認</small>
            </div>
            <div>
              <span>02</span><strong>費用参照（Cost reader）</strong><small>請求 / Cost Explorer参照</small>
            </div>
            <div class="permission-chain__role--operator">
              <span>03</span><strong>環境構築（Deploy operator）</strong><small>1時間だけ有効な認証情報</small>
              <em>権限上限（Permissions Boundary）</em>
            </div>
          </div>
        </figure>
      </div>

      <div class="shell permission-facts" data-reveal>
        <article>
          <span>一時権限</span>
          <h3>STSで一時クレデンシャルを発行する</h3>
          <p>IAMユーザーへ強い権限を常設せず、ロールセッション中だけ必要な権限を付与します。</p>
        </article>
        <article>
          <span>切替元の制限</span>
          <h3>信頼ポリシーでRoleへ切り替えられる利用者を限定する</h3>
          <p>呼び出し元の設定だけでなく、Role側の信頼ポリシーでも許可するIAMユーザーを限定します。</p>
        </article>
        <article>
          <span>権限上限</span>
          <h3>Permissions Boundaryで許可できる範囲の上限を固定する</h3>
          <p>環境構築用Roleは、通常の権限設定とBoundaryの両方が許可する操作だけを実行できます。</p>
        </article>
      </div>

      <aside class="reader-bridge shell" data-reveal>
        <div class="reader-bridge__label">
          <span>理解の補助線</span>
          <strong>IAMを平たく言うと</strong>
        </div>
        <div>
          <h3>万能鍵を持ち歩かず、用事ごとに期限付きの鍵を借ります。</h3>
          <p>
            普段使う利用者には強い権限を置かず、設定を見る時、費用を見る時、環境を作る時で別のロールへ切り替えます。
            デプロイの鍵は一時間で失効し、許可できる範囲にも上限を設けています。
          </p>
          <p class="reader-bridge__meaning"><strong>実務上の意味</strong>操作ミスや認証情報の流出が起きた場合でも、使える時間と影響範囲を狭くできます。</p>
        </div>
      </aside>
    </section>

    <section class="section section--soft deployment-story" id="deploy">
      <div class="shell">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">AWSへ配置する各要素の役割</p>
          <h2>AWSのマネージドサービスへ、<br />責務を分割して配置する。</h2>
          <p>
            Terraformモジュールで各サービスの構成と依存関係を定義し、同じコミットから検証環境を再構築できます。
          </p>
        </div>

        <div class="cloud-role-map" data-reveal>
          <article>
            <span>外部HTTPSの入口</span><h3>WebとAPIへ振り分ける</h3><p>外部HTTPSを受け付け、WebとAPIを見つける仕組みへ接続する。</p><small>API Gateway / Cloud Map</small>
          </article>
          <article>
            <span>利用者の本人確認</span><h3>認証とtoken発行</h3><p>利用者の認証とtoken発行を担当し、APIが権限を確認できる情報へ接続する。</p><small>Cognito</small>
          </article>
          <article>
            <span>Web・API・MLの実行</span><h3>containerを個別に動かす</h3><p>Web、API、MLワーカーを独立したtask定義とECS serviceで実行する。</p><small>ECS / Fargate</small>
          </article>
          <article>
            <span>処理依頼の配送</span><h3>時間のかかる処理をqueueへ渡す</h3><p>APIとMLワーカーを分離し、処理依頼の配送と再試行を管理する。</p><small>Amazon MQ</small>
          </article>
          <article>
            <span>業務データとファイル保存</span><h3>記録の種類で保存先を分ける</h3><p>業務状態と監査logはRDS、PDFと生成fileはS3へ分離して保存する。</p><small>RDS / S3</small>
          </article>
          <article>
            <span>logによる処理追跡</span><h3>実行記録を一か所へ集める</h3><p>各containerとbuildのlogを集約し、workflow IDから処理を追跡する。</p><small>CloudWatch Logs</small>
          </article>
        </div>

        <div class="runtime-choice" data-reveal>
          <div class="runtime-choice__lead">
            <p class="eyebrow">Fargateを選んだ理由</p>
            <h3>短期間だけ使う検証環境で、<br />server管理を対象から外す。</h3>
            <p>
              Web、API、MLワーカーのコンテナ分割を実AWSでも維持し、EC2インスタンスのプロビジョニングやOS保守を検証対象から外すため、ECS/Fargateを選びました。E2E完了後に実行環境をまとめて撤収しやすいことも判断理由です。
            </p>
          </div>
          <div class="runtime-choice__comparison">
            <article>
              <span>EC2で考えると</span>
              <strong>EC2キャパシティを管理する</strong>
              <p>台数、インスタンスタイプ、OSパッチ、ECS agent、キャパシティ不足時のスケーリングを設計・運用します。</p>
            </article>
            <article class="runtime-choice__selected">
              <span>Fargateで考えると</span>
              <strong>タスク単位でCPUとメモリを指定する</strong>
              <p>タスク定義にリソースを記述し、検証時だけコンテナを起動します。短命な環境の構築・撤収へ集中できます。</p>
            </article>
          </div>
          <p class="runtime-choice__boundary">
            Fargateが常時稼働で常に最安という主張ではありません。EC2の台数や空き容量の管理を対象外とし、build・E2E・destroyの全工程を検証するための選択です。
          </p>
        </div>

        <aside class="reader-bridge" data-reveal>
          <div class="reader-bridge__label">
            <span>理解の補助線</span>
            <strong>Fargateを選ぶ意味</strong>
          </div>
          <div>
            <h3>サーバーそのものの保守を減らし、アプリの検証へ集中します。</h3>
            <p>
              EC2では仮想サーバーの台数、OS更新、空き容量なども管理対象になります。Fargateでは必要なCPUとメモリを指定し、検証する間だけコンテナを実行できます。
              今回はサーバー運用の比較ではなく、アプリケーションを配置して片付ける工程を確かめるため、この方式を選びました。
            </p>
            <p class="reader-bridge__meaning"><strong>実務上の意味</strong>何を検証し、何をAWSへ任せるかを明確にし、短命な環境の構築と撤収へ作業を絞れます。</p>
          </div>
        </aside>
      </div>
    </section>

