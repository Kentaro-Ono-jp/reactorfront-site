---
import BaseLayout from "../layouts/BaseLayout.astro";

const disciplines = [
  {
    title: "アプリケーション",
    description: "業務要件をデータモデルとAPIへ落とし込み、フロントエンドからバックエンドまで実装します。",
    items: ["TypeScript", "React / Next.js", "Python / FastAPI", "PostgreSQL", "OpenAPI"],
  },
  {
    title: "基盤と運用",
    description: "IaC、CI/CD、監視、障害復旧、リソース撤収までをシステムの設計範囲として扱います。",
    items: ["Linux", "Docker", "AWS", "Terraform", "GitHub Actions", "RabbitMQ"],
  },
  {
    title: "機械学習",
    description: "モデル評価、データの来歴、Human-in-the-loop、更新とロールバックをアプリケーションへ統合します。",
    items: ["PyTorch", "Document Intelligence", "Model Evaluation", "Human-in-the-loop"],
  },
];

const careerPeriods = [
  {
    period: "2001–2020",
    label: "Enterprise systems / operations",
    title: "業務システムと運用の土台",
    description:
      "半導体設計支援、官公庁、銀行、自動車製造、医療機器管理のシステムに携わりました。既存改修、DB設計、性能改善、Linux運用、サーバー移行まで、長期運用されるシステムの変更と保守を経験しています。",
    facts: ["半導体設計支援 6年", "官公庁システム 6年", "Linux専任運用 5年", "代打PM 2年"],
  },
  {
    period: "2020–2025",
    label: "Modern web / cloud",
    title: "大規模業務Webのモダナイズ",
    description:
      "全国のディーラーが利用する自動車リコール対応支援システムへ4年半参画。国への届出、対象車両、部品在庫、作業管理、帳票、通知を扱う業務を、React / Next.js、Java、SQL、Linux、AWSをまたいで開発しました。",
    facts: ["長期参画 4年半", "要件定義〜デプロイ", "React / Next.js", "Java / SQL / AWS"],
  },
  {
    period: "2025–2026",
    label: "Documents / OCR",
    title: "帳票・OCR・クラウドを横断",
    description:
      "医療機関向けWeb問診で、React / TypeScriptのUI、Python / FlaskのAPI、QRコード・差分表示を含むPDF生成を担当。帳票構造を先に確定し、OCR結果を既知のフィールドに対して検証するSchema-firstの処理へつなげました。",
    facts: ["React / TypeScript", "Python / Flask", "PDF / OCR", "AWS / Azure"],
  },
  {
    period: "2026–現在",
    label: "Machine learning R&D",
    title: "開発・運用経験を機械学習へ",
    description:
      "現在は機械学習の研究開発案件に業務委託で参画し、画像解析、OCR、モデル評価・改善に取り組んでいます。モデル単体ではなく、入力データ、評価、人による確認、更新、監査までを業務システムとして捉えます。",
    facts: ["画像解析 / OCR", "Model Evaluation", "Human-in-the-loop", "Document Intelligence"],
  },
];

const experienceEvidence = [
  {
    metric: "約2万人",
    title: "Windows Serverの老朽更新",
    description:
      "社内ユーザー約2万人の環境で、サーバーのインストール、各種設定、プログラム置き換え、チューニング、全動作確認を専任で8か月担当しました。",
  },
  {
    metric: "4年半",
    title: "自動車リコール対応支援",
    description:
      "全国拠点、行政への届出、車両・部品・作業・帳票を扱うWebシステムで、ヒアリングから設計、実装、性能試験、デプロイまで継続して担当しました。",
  },
  {
    metric: "400台規模",
    title: "半導体設計用Linuxサーバの運用保守",
    description:
      "半導体設計を支えるLinuxサーバ群の運用保守を5年間担当。Shell Scriptの設計・実装、環境設定、構築、運用方針の策定まで、開発基盤の安定稼働を支えました。",
  },
  {
    metric: "2年間",
    title: "プロジェクトマネジメント",
    description:
      "プロジェクトマネージャーの引継ぎ役として、2年間マネジメントに専任。開発者としてだけでなく、案件を継続させる立場も担いました。",
  },
  {
    metric: "UI → Cloud",
    title: "医療Web問診を横断",
    description:
      "React / TypeScriptのUI、Python / FlaskのAPI、QRコード・差分表示付きPDF、AWS / Azureでのデプロイ・ログ確認・障害調査まで担当しました。",
  },
  {
    metric: "Schema-first",
    title: "帳票構造とOCR",
    description:
      "Word帳票から罫線、セル、入力フィールドを抽出して構造化。レイアウト、フィールド特定、OCR、Validationを分け、結果を検証可能にしました。",
  },
];
---

<BaseLayout
  title="プロフィール"
  description="ReactorFront代表・小野賢太郎のプロフィール。システム開発25年以上、Linux専任運用保守5年の経験を土台に、現在は機械学習の研究開発に取り組んでいます。"
>
  <section class="page-hero page-hero--profile">
    <div class="shell page-hero__inner">
      <div class="breadcrumbs" aria-label="パンくずリスト">
        <a href="/">Home</a><span aria-hidden="true">/</span><span>Profile</span>
      </div>
      <div class="page-hero__grid">
        <div>
          <p class="eyebrow eyebrow--light">Profile</p>
          <h1>業務要件から、<br />本番運用まで。</h1>
        </div>
        <p class="page-hero__lead">
          システム開発25年以上、Linux専任の運用保守5年。
          半導体、官公庁、銀行、自動車、医療で積み上げた経験を、現在の機械学習R&amp;Dへつないでいます。
        </p>
      </div>
    </div>
  </section>

  <section class="section profile-overview">
    <div class="shell profile-overview__grid">
      <aside class="profile-card" data-reveal>
        <img
          class="profile-card__logo"
          src="/images/reactorfront-logo.png"
          width="512"
          height="512"
          alt="ReactorFrontのロゴ"
          decoding="async"
        />
        <p class="profile-card__name">小野賢太郎 <span>Kentaro Ono</span></p>
        <p>ReactorFront 代表<br />Independent Software Engineer</p>
        <dl>
          <div><dt>拠点</dt><dd>東京 / フルリモート</dd></div>
          <div><dt>現在</dt><dd>機械学習 R&amp;D</dd></div>
          <div><dt>連絡</dt><dd><a href="mailto:kentaro.ono@reactorfront.jp">Email ↗</a></dd></div>
        </dl>
      </aside>

      <div class="profile-story" data-reveal>
        <p class="eyebrow">About</p>
        <h2>25年、業務システムを<br />作り、直し、運用してきた。</h2>
        <div class="prose prose--large">
          <p>
            半導体設計支援、官公庁の道路交通量・帳票、銀行口座開設、自動車の在庫・リコール対応、医療機器管理とWeb問診。
            業界も技術も異なりますが、複雑な業務とデータを整理し、利用者が継続して使えるシステムへ落とし込む仕事を続けてきました。
          </p>
          <p>
            新規開発だけでなく、既存コードの改修、DB設計、性能改善、Linux運用、約2万人規模のサーバー更新も経験しました。
            要件定義から実装、テスト、デプロイ、障害調査までを一人称で追えるため、レイヤー間の引継ぎと認識のずれを減らせます。
          </p>
          <p>
            現在の機械学習R&amp;Dでも、モデル精度だけを切り出してはいません。
            入力データ、評価条件、人によるレビュー、モデル更新、監査、障害時の復旧までを、一つの業務システムとして扱います。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section findy-proof-section" aria-labelledby="findy-score-heading">
    <div class="shell findy-proof" data-reveal>
      <div class="findy-proof__body">
        <p class="eyebrow eyebrow--accent">Third-party signal</p>
        <h2 id="findy-score-heading">公開コードを、<br />第三者の指標でも。</h2>
        <p>
          Findyが公開GitHubリポジトリを独自に解析して算出した、スキル偏差値Ver.3です。
          2026年8月14日時点でTotal 71.0、Python 71.3でした。
        </p>
        <p>
          転職活動のために登録しているわけではありません。自分のGitHubを外から定量的に見る手段の一つとして利用しています。
          この値が技術力のすべてだとは考えていませんが、ポートフォリオを作り、改善を続ける際には、数字の変化を正直な励みにしています。
        </p>
        <p>
          この自社サイトのリポジトリも評価対象に含まれます。Findyが「人に伝える力」そのものを採点するわけではありませんが、
          コード、設計意図、検証結果を伝わる形で残せているかまで含め、公開物全体を見直すためのシビアな外部指標の一つとして受け止めています。
        </p>
        <p class="findy-proof__note">
          画像は取得時点の記録です。クリックするとFindyが新しいタブで開きます。
        </p>
      </div>

      <a
        class="findy-proof__link"
        href="https://findy-code.io/home"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Findyを開く（新しいタブ）"
      >
        <img
          src="/images/findy-skill-score-2026-08-14.png"
          width="723"
          height="262"
          alt="Findy スキル偏差値ver.3。Total 71.0、Python 71.3（2026年8月14日時点）"
          loading="lazy"
          decoding="async"
        />
        <span>Findyを開く <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  </section>

  <section class="section section--soft career-section">
    <div class="shell">
      <div class="section-heading section-heading--split" data-reveal>
        <div>
          <p class="eyebrow">Career timeline</p>
          <h2>25年を、四つの期間で見る。</h2>
        </div>
        <p>
          古い技術名を並べるための年表ではありません。
          業務、データ、アプリケーション、運用へと、担当範囲を広げてきた経過です。
        </p>
      </div>

      <ol class="career-timeline">
        {
          careerPeriods.map((career) => (
            <li data-reveal>
              <span class="career-timeline__year">{career.period}</span>
              <div>
                <p class="career-timeline__phase">{career.label}</p>
                <h3>{career.title}</h3>
                <p>{career.description}</p>
                <ul class="career-timeline__facts" aria-label={`${career.title}の主な経験`}>
                  {career.facts.map((fact) => <li>{fact}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section experience-evidence">
    <div class="shell">
      <div class="section-heading section-heading--split" data-reveal>
        <div>
          <p class="eyebrow">Selected evidence</p>
          <h2>規模・期間・担当範囲で、<br />経験を示す。</h2>
        </div>
        <p>
          案件名や顧客情報ではなく、規模、期間、担当範囲を公開します。
          長期運用、既存システム、業務データを扱ってきた経験の一部です。
        </p>
      </div>
      <div class="experience-proof-grid">
        {
          experienceEvidence.map((evidence, index) => (
            <article data-reveal>
              <span class="experience-proof-grid__number">0{index + 1}</span>
              <strong>{evidence.metric}</strong>
              <h3>{evidence.title}</h3>
              <p>{evidence.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">Working principles</p>
        <h2>設計・実装で重視すること。</h2>
      </div>
      <div class="principle-grid">
        <article data-reveal><span>01</span><h3>事実と仮説を分ける</h3><p>ログや計測で確認した事実、現時点の仮説、未確認事項を明確に分けます。</p></article>
        <article data-reveal><span>02</span><h3>失敗経路を先に考える</h3><p>正常系だけでなく、再実行、ロールバック、タイムアウト、安全な終了を設計します。</p></article>
        <article data-reveal><span>03</span><h3>意思決定を記録する</h3><p>コードに表れない制約やトレードオフは、ADRや運用資料として残します。</p></article>
        <article data-reveal><span>04</span><h3>必要な複雑さだけを持つ</h3><p>現在の要件を満たす最小構成から始め、将来の拡張点を明示します。</p></article>
      </div>
    </div>
  </section>

  <section class="section section--dark discipline-section">
    <div class="shell">
      <div class="section-heading section-heading--split" data-reveal>
        <div>
          <p class="eyebrow eyebrow--accent">Technical range</p>
          <h2>技術世代を越えて、<br />システム全体を扱う。</h2>
        </div>
        <p>
          PL/I、Delphi、Java、Oracleから、React、Python、AWS、機械学習まで。
          過去の技術を現在の主力として並べるのではなく、既存資産を読み解き、次の構成へ接続するための経験として使います。
        </p>
      </div>
      <div class="discipline-grid">
        {
          disciplines.map((discipline, index) => (
            <article data-reveal>
              <span class="discipline-grid__number">0{index + 1}</span>
              <h3>{discipline.title}</h3>
              <p>{discipline.description}</p>
              <ul class="tag-list tag-list--dark">
                {discipline.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section next-step">
    <div class="shell next-step__inner" data-reveal>
      <div>
        <p class="eyebrow">Evidence, not adjectives</p>
        <h2>設計と検証の記録を、公開ポートフォリオで示す。</h2>
        <p>
          25年の実務で得た業務設計、データ、運用の視点を、公開可能なDocument Intelligence基盤として再構成しました。
          アプリケーション、機械学習、AWS運用の設計判断と検証結果を、コードと日本語解説で公開しています。
        </p>
      </div>
      <a class="button button--dark" href="/portfolio/">ポートフォリオ解説へ <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
