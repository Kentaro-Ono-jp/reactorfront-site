---
import BaseLayout from "../layouts/BaseLayout.astro";

const disciplines = [
  {
    title: "アプリケーション",
    description: "業務要件をデータモデルとAPIへ落とし込み、フロントエンドからバックエンドまで実装します。",
    items: ["TypeScript", "React / Next.js", "Python / FastAPI", "PostgreSQL", "OpenAPI"],
  },
  {
    title: "基盤と運用",
    description: "IaC、CI/CD、監視、障害復旧、リソース撤収までをシステムの設計範囲として扱います。",
    items: ["Linux", "Docker", "AWS", "Terraform", "GitHub Actions", "RabbitMQ"],
  },
  {
    title: "機械学習",
    description: "モデル評価、データの来歴、Human-in-the-loop、更新とロールバックをアプリケーションへ統合します。",
    items: ["PyTorch", "Document Intelligence", "Model Evaluation", "Human-in-the-loop"],
  },
];
---

<BaseLayout
  title="プロフィール"
  description="ReactorFront代表・小野賢太郎のプロフィール。システム開発20年以上、Linux運用保守5年の経験を土台に、現在は機械学習の研究開発に取り組んでいます。"
>
  <section class="page-hero page-hero--profile">
    <div class="shell page-hero__inner">
      <div class="breadcrumbs" aria-label="パンくずリスト">
        <a href="/">Home</a><span aria-hidden="true">/</span><span>Profile</span>
      </div>
      <div class="page-hero__grid">
        <div>
          <p class="eyebrow eyebrow--light">Profile</p>
          <h1>業務要件から、<br />本番運用まで。</h1>
        </div>
        <p class="page-hero__lead">
          システム開発20年以上、Linuxを中心とした運用保守5年。
          現在は、これまでの開発・運用経験を機械学習の研究開発に生かしています。
        </p>
      </div>
    </div>
  </section>

  <section class="section profile-overview">
    <div class="shell profile-overview__grid">
      <aside class="profile-card" data-reveal>
        <img
          class="profile-card__logo"
          src="/images/reactorfront-logo.png"
          width="512"
          height="512"
          alt="ReactorFrontのロゴ"
          decoding="async"
        />
        <p class="profile-card__name">小野賢太郎 <span>Kentaro Ono</span></p>
        <p>ReactorFront 代表<br />Independent Software Engineer</p>
        <dl>
          <div><dt>拠点</dt><dd>東京 / フルリモート</dd></div>
          <div><dt>現在</dt><dd>機械学習 R&amp;D</dd></div>
          <div><dt>連絡</dt><dd><a href="mailto:kentaro.ono@reactorfront.jp">Email ↗</a></dd></div>
        </dl>
      </aside>

      <div class="profile-story" data-reveal>
        <p class="eyebrow">About</p>
        <h2>20年以上、システムの<br />ライフサイクルに関わってきた。</h2>
        <div class="prose prose--large">
          <p>
            業務システムを中心に、要件整理、設計、実装、テスト、リリース後の保守まで経験してきました。
            特定のフレームワークを使うことより、業務上の責務をどこへ置き、変更に耐えられる境界をどう作るかを重視しています。
          </p>
          <p>
            Linux運用保守では、ログ調査、障害切り分け、復旧、定常運用に携わりました。
            その経験から、アプリケーションの仕様だけでなく、デプロイ方法、可観測性、ロールバック、運用担当者の作業まで含めて設計を判断します。
          </p>
          <p>
            現在取り組んでいる機械学習R&amp;Dでも考え方は同じです。
            推論精度だけを切り出さず、データセットとモデルの来歴、再現可能な評価、人によるレビュー、リリース判断、障害時の復旧までを一つのシステムとして扱います。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft career-section">
    <div class="shell">
      <div class="section-heading section-heading--split" data-reveal>
        <div>
          <p class="eyebrow">Career layers</p>
          <h2>開発と運用の経験を、<br />機械学習R&amp;Dへ。</h2>
        </div>
        <p>
          アプリケーション、インフラ、運用、機械学習を別々の経歴にはせず、
          システム全体を判断するための経験として積み上げています。
        </p>
      </div>

      <ol class="career-timeline">
        <li data-reveal>
          <span class="career-timeline__year">20+ years</span>
          <div>
            <h3>システム開発</h3>
            <p>業務システムを中心に、要件整理、基本・詳細設計、実装、テスト、保守を担当。長期運用されるコードとデータに向き合ってきました。</p>
          </div>
        </li>
        <li data-reveal>
          <span class="career-timeline__year">5 years</span>
          <div>
            <h3>Linux運用保守</h3>
            <p>Linuxサーバーの運用、ログ調査、障害切り分け、復旧、定常作業を経験。実運用で必要になる情報と手順を学びました。</p>
          </div>
        </li>
        <li data-reveal>
          <span class="career-timeline__year">Current</span>
          <div>
            <h3>機械学習の研究開発</h3>
            <p>モデル評価の再現性、データ・モデルの来歴管理、Human-in-the-loopを含むプロダクト実装に取り組んでいます。</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">Working principles</p>
        <h2>設計・実装で重視すること。</h2>
      </div>
      <div class="principle-grid">
        <article data-reveal><span>01</span><h3>事実と仮説を分ける</h3><p>ログや計測で確認した事実、現時点の仮説、未確認事項を明確に分けます。</p></article>
        <article data-reveal><span>02</span><h3>失敗経路を先に考える</h3><p>正常系だけでなく、再実行、ロールバック、タイムアウト、安全な終了を設計します。</p></article>
        <article data-reveal><span>03</span><h3>意思決定を記録する</h3><p>コードに表れない制約やトレードオフは、ADRや運用資料として残します。</p></article>
        <article data-reveal><span>04</span><h3>必要な複雑さだけを持つ</h3><p>現在の要件を満たす最小構成から始め、将来の拡張点を明示します。</p></article>
      </div>
    </div>
  </section>

  <section class="section section--dark discipline-section">
    <div class="shell">
      <div class="section-heading section-heading--split" data-reveal>
        <div>
          <p class="eyebrow eyebrow--accent">Technical range</p>
          <h2>複数のレイヤーを、<br />一つのシステムとして扱う。</h2>
        </div>
        <p>
          採用技術そのものだけでなく、責務分割、インターフェース、テスト方法、運用主体まで説明できる設計を目指します。
        </p>
      </div>
      <div class="discipline-grid">
        {
          disciplines.map((discipline, index) => (
            <article data-reveal>
              <span class="discipline-grid__number">0{index + 1}</span>
              <h3>{discipline.title}</h3>
              <p>{discipline.description}</p>
              <ul class="tag-list tag-list--dark">
                {discipline.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section next-step">
    <div class="shell next-step__inner" data-reveal>
      <div>
        <p class="eyebrow">Evidence, not adjectives</p>
        <h2>設計と検証の記録を、公開ポートフォリオで示す。</h2>
        <p>
          顧客情報に触れずに技術判断を確認できるよう、アプリケーション、機械学習、AWS運用の設計と検証結果を公開しています。
        </p>
      </div>
      <a class="button button--dark" href="/portfolio/">ポートフォリオ解説へ <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
