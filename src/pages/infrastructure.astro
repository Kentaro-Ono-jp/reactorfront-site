---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ArticleCover from "../components/ArticleCover.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { articleReadingMinutes } from "../reading-times";
import { getArticleRouteMetadata, SITE_URL } from "../site-metadata";
import { createArticle, type BreadcrumbItem } from "../structured-data";

const breadcrumbs = [
  { name: "ホーム", href: "/" },
  { name: "独自ドメイン・Web・メール基盤", href: "/infrastructure/" },
] satisfies BreadcrumbItem[];

const articleTitle = "独自ドメイン・Web・仕事用メールを構築し、外部から確認して維持する手順";
const articleDescription = "ReactorFront（リアクターフロント）の実構成を基に、独自ドメイン、GitHub Pages、GitHub Actions、Google Workspace、DNS、SPF・DKIM・DMARCを設定し、外部から確認して維持する手順を説明します。";
const articleMetadata = getArticleRouteMetadata("/infrastructure/");
const canonical = new URL(articleMetadata.path, SITE_URL).href;
const representativeImagePath = "/images/article-freelance-infrastructure.webp";
const representativeImage = new URL(representativeImagePath, canonical).href;
const representativeImageAlt = "独自ドメインのDNSからWebサイト、仕事用メール、事業用サービスへ案内する構成図";
const { datePublished, lastModified: dateModified } = articleMetadata;
const articleSchema = createArticle({
  canonical,
  headline: articleTitle,
  description: articleDescription,
  images: [representativeImage],
  datePublished,
  dateModified,
});

const verifiedAt = "2026-08-23";

const records = [
  { type: "A / AAAA", role: "ホスト名をIPアドレスへ対応付ける", example: "example.com → GitHub PagesのIP", note: "IPv4 / IPv6" },
  { type: "CNAME", role: "ホスト名に別名を設定する", example: "www.example.com → owner.github.io", note: "サブドメイン向け" },
  { type: "MX", role: "メールを受け取るサーバーを指定する", example: "example.com → 管理画面が示すメールサーバー", note: "優先度あり" },
  { type: "TXT", role: "所有確認・送信ポリシー・公開鍵を記録する", example: "所有確認 / SPF / DKIM / DMARC", note: "秘密鍵は置かない" },
];
---

<BaseLayout
  title={articleTitle}
  description={articleDescription}
  image={representativeImagePath}
  imageAlt={representativeImageAlt}
  imageWidth={1536}
  imageHeight={1024}
  imageType="image/webp"
  breadcrumbs={breadcrumbs}
  structuredData={articleSchema}
>
  <article class="infrastructure-story">
  <section class="page-hero page-hero--infrastructure">
    <div class="page-hero__circuit" aria-hidden="true"></div>
    <div class="shell page-hero__inner">
      <Breadcrumbs items={breadcrumbs} />
      <div class="page-hero__grid">
        <div>
          <p class="eyebrow eyebrow--accent">独自ドメインから始める事業用IT基盤</p>
          <h1>独自ドメインから、<br />Webとメールを<br />構築・確認し、<br />維持する。</h1>
        </div>
        <div class="page-hero__lead">
          <p>
            独自ドメイン、仕事用メール、Webサイト。
            ドメイン契約、DNS、Web公開、メール送受信の役割を分け、ReactorFront（リアクターフロント）の実構成に沿って、設定順と外部からの確認方法を説明します。
          </p>
          <div class="article-byline" aria-label="記事情報">
            <span>著者 <a href="/profile/" rel="author">小野賢太郎</a></span>
            <span>公開 <time datetime={datePublished}>2026年8月14日</time></span>
            <span>最終更新 <time datetime={dateModified}>2026年8月23日</time></span>
          </div>
          <span class="reading-time">約{articleReadingMinutes.infrastructure}分 / 実地確認: {verifiedAt}</span>
        </div>
      </div>
    </div>
  </section>

  <ArticleCover
    src={representativeImagePath}
    alt={representativeImageAlt}
    caption="独自ドメインを事業の基準点にし、Web、メール、クラウドの責務と経路を自分で管理する。"
  />

  <section class="section infra-prologue" aria-labelledby="infra-prologue-title">
    <div class="shell">
      <div class="infra-prologue__heading" data-reveal>
        <div>
          <p class="eyebrow">この基盤を整えた理由</p>
          <h2 id="infra-prologue-title">まず欲しかったのは、<br />仕事の「住所」でした。</h2>
        </div>
        <p class="infra-prologue__lead">
          脱サラし、税務署へ開業届を提出して、フリーランスとして生きていくと決めた。
          屋号をReactorFront（リアクターフロント）と定めた後、最初に立ち止まったのは、意外にもメールアドレスでした。
        </p>
      </div>

      <div class="infra-prologue__story">
        <article class="infra-prologue__narrative" data-reveal>
          <span class="infra-prologue__chapter">個人用から事業用へ</span>
          <p>
            無料のGmailアドレスでも、仕事そのものには困らないかもしれません。
            けれど、せっかく屋号を掲げるなら、その名前を持つ独自ドメインのメールアドレスがほしい。
            自社サイトも、借り物に見えない独自ドメインのURLで公開したい。そう考えるようになりました。
          </p>
          <p>
            そこでXServerドメインでドメインを契約し、Google Workspaceで仕事用メールを整備しました。
            Webサイトとメールという二つの入口がそろったことで、屋号は届け出の紙に書かれた名前から、
            インターネット上に自分の居場所を持つ事業へと、少しずつ形を変えていきました。
          </p>
        </article>

        <aside class="infra-prologue__address" data-reveal aria-label="独自ドメインから広がる事業用の連絡先">
          <p>一つの屋号を基準にする</p>
          <div class="infra-prologue__domain">
            <span>独自ドメイン</span>
            <strong>reactorfront.jp</strong>
          </div>
          <div class="infra-prologue__branches">
            <div><span>メール</span><strong>仕事用メール</strong><small>問い合わせ・通知</small></div>
            <div><span>Web</span><strong>自社サイト</strong><small>実績・事業案内</small></div>
            <div><span>アカウント</span><strong>事業用サービス</strong><small>会計・契約管理</small></div>
          </div>
        </aside>
      </div>

      <div class="infra-prologue__outcomes" data-reveal>
        <article>
          <span>01 / 事業書類</span>
          <h3>事業の連絡先として書ける</h3>
          <p>ネット銀行へ口座開設を申し込む際、事業計画書へ独自ドメインのメールアドレスと自社サイトを記載できました。</p>
        </article>
        <article>
          <span>02 / 屋号の案内</span>
          <h3>名刺に、屋号の入口を載せられる</h3>
          <p>名前や電話番号だけでなく、仕事用メールと自社サイトのURLを、ReactorFrontの連絡先として案内できました。</p>
        </article>
        <article>
          <span>03 / 通知の管理</span>
          <h3>事業の通知を、一か所へ集められる</h3>
          <p>freee会計をはじめ、Google Workspaceなど事業で使うサービスの登録先・通知先を、個人用メールと分けて管理できます。</p>
        </article>
      </div>

      <p class="infra-prologue__closing" data-reveal>
        本記事の <strong>ReactorFront</strong>、<strong>リアクターフロント</strong>、検索時に使われる小文字表記 <strong>reactorfront</strong> は、すべて小野賢太郎が運営する同じ事業を指します。
        <code>reactorfront.jp</code> は、その事業がWebと仕事用メールに使う独自ドメインです。
        独自ドメインは、見栄えを整えるためだけのものではありませんでした。
        外へ示す信用の手掛かりであり、事業の連絡と契約を整理するための基準点でもあります。
        この入門は、その基準点をどう作り、どう守ってきたかを、実体験から順にほどく記録です。
      </p>
    </div>
  </section>

  <section class="section guide-intro">
    <div class="shell guide-intro__grid">
      <div data-reveal>
        <p class="eyebrow">ReactorFrontの実構成</p>
        <h2>ReactorFrontの実構成を、<br />ケーススタディにする。</h2>
      </div>
      <div class="prose prose--large" data-reveal>
        <p>
          ReactorFrontは、XServerドメインで契約した独自ドメイン、GitHub PagesのWebサイト、Google Workspaceの仕事用メールを組み合わせています。
          外部の問い合わせへ正式な情報を返すDNS（権威DNS）にWeb・メール用レコードを設定し、SPF・DKIM・DMARCも有効化しました。
          設定後は公開DNS、HTTPS、受信側の認証結果、DMARCレポートを継続して確認しています。
        </p>
        <p>
          本文では実ドメインを <code>example.com</code> に置き換え、サービス間の関係と検証方法を説明します。
          アカウント固有のトークンや鍵は公開せず、値を取得する公式資料へのリンクを示します。
        </p>
      </div>
    </div>

    <div class="infra-architecture shell" data-reveal aria-label="フリーランス向けインフラの構成図">
      <div class="infra-architecture__source">
        <span>契約・名前の管理</span>
        <strong>XServerドメイン</strong>
        <small>ドメイン契約 / 正式なDNS応答</small>
      </div>
      <div class="infra-architecture__hub">
        <span class="infra-architecture__pulse" aria-hidden="true"></span>
        <strong>DNS</strong>
        <small>名前解決 / 経路指定</small>
      </div>
      <div class="infra-architecture__destinations">
        <div>
          <span>Web</span>
          <strong>GitHub Pages</strong>
          <small>静的サイト / HTTPS</small>
        </div>
        <div>
          <span>メール</span>
          <strong>Google Workspace</strong>
          <small>送受信 / 認証</small>
        </div>
      </div>
      <svg viewBox="0 0 900 240" preserveAspectRatio="none" aria-hidden="true">
        <path d="M270 120H385" /><path d="M515 120H610V64H650" /><path d="M610 120v56h40" />
      </svg>
    </div>

    <aside class="reader-bridge shell" data-reveal>
      <div class="reader-bridge__label">
        <span>理解の補助線</span>
        <strong>要するに</strong>
      </div>
      <div>
        <h3>一つの「ホームページ契約」で、Webもメールも全部動いているわけではありません。</h3>
        <p>
          独自ドメインという共通の名前を持ち、DNSでWebはGitHub Pages、メールはGoogle Workspaceへ案内しています。
          XServerドメインは、その名前と案内先を管理する場所です。見た目は一つの屋号でも、裏側では役割の異なるサービスを組み合わせています。
        </p>
        <p class="reader-bridge__meaning"><strong>実務上の意味</strong>問題が起きた時に契約先を総当たりせず、ドメイン、DNS、Web、メールのどこを確認すべきか切り分けられます。</p>
      </div>
    </aside>
  </section>

  <section class="section section--soft role-section">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">最初に分ける四つの役割</p>
        <h2>契約先と、実際に担う機能を分ける。</h2>
        <p>一社が複数サービスを提供していても、レジストラ、権威DNS、Web、メールは別の機能です。</p>
      </div>
      <div class="role-grid">
        <article data-reveal>
          <span>01</span><h3>ドメインを契約・更新する事業者（レジストラ）</h3>
          <p><code>example.com</code> を登録・更新する事業者です。契約が失効するとWebとメールの両方へ影響します。</p>
        </article>
        <article data-reveal>
          <span>02</span><h3>正式なDNS情報を返す場所（権威DNS）</h3>
          <p>ドメインのDNSレコードを保持し、問い合わせへ応答します。NSレコードを見れば、現在の管理先を特定できます。</p>
        </article>
        <article data-reveal>
          <span>03</span><h3>Webサイトの公開先（Webホスティング）</h3>
          <p>サイトをHTTPSで配信するサービスです。この構成では、GitHub Actionsでビルドした静的サイトをGitHub Pagesから配信します。</p>
        </article>
        <article data-reveal>
          <span>04</span><h3>仕事用メールの送受信先（メールサービス）</h3>
          <p>独自ドメインのメールボックスと送受信機能を提供します。この構成ではGoogle Workspaceです。</p>
        </article>
      </div>
      <div class="guide-tip" data-reveal>
        <strong>DNSレコードを編集する場所の特定方法</strong>
        <p>
          契約先の名称だけで判断せず、最初にDNSの管理先を示す <strong>NS（ネームサーバー）</strong> を確認します。
          XServerドメインなら、契約一覧のクイックメニューにある「DNSレコード設定」が入口です。レンタルサーバーの管理画面とは別の場合があります。
        </p>
        <a href="https://www.xdomain.ne.jp/manual/man_domain_dns_setting.php" target="_blank" rel="noreferrer">XServerドメイン公式: DNSレコードの編集 ↗</a>
      </div>
    </div>
  </section>

  <section class="section section--dark pages-platform-section" aria-labelledby="pages-platform-title">
    <div class="shell">
      <div class="section-heading section-heading--split" data-reveal>
        <div>
          <p class="eyebrow eyebrow--accent">GitHub Pagesを選んだ理由</p>
          <h2 id="pages-platform-title">無料だから、だけでは<br />選ばなかった。</h2>
        </div>
        <p>
          開業時に必要だったのは、会社案内、プロフィール、実績、技術記事を公開する場所でした。
          コメントや会員機能よりも、更新の履歴を残し、壊れた時に戻せて、サーバーを抱えず公開できることを優先しました。
        </p>
      </div>

      <div class="pages-decision-grid" data-reveal>
        <article>
          <span>01 / 静的サイト公開</span>
          <h3>静的サイトを、追加のサーバー契約なしで公開する</h3>
          <p>Astroが生成したHTML、CSS、JavaScriptをGitHub Pagesから配信します。公開リポジトリならGitHub Freeで利用でき、OSやWebサーバーを自分で保守しません。</p>
        </article>
        <article>
          <span>02 / 変更履歴</span>
          <h3>更新した事実と、変更前の状態を残す</h3>
          <p>commit、変更差分（diff）、Pull Requestで、いつ何を変えたかを追えます。不具合があれば、履歴を消さず、変更を取り消すcommit（revert）で戻せます。</p>
        </article>
        <article>
          <span>03 / buildと公開</span>
          <h3>ビルドと公開を、同じ場所で自動化する</h3>
          <p><code>main</code>へ反映するとGitHub Actionsが検査して公開用fileを生成し、成功したfileだけをPagesへ公開します。失敗した工程と対象commitも実行履歴に残ります。</p>
        </article>
        <article>
          <span>04 / 対象外にする機能</span>
          <h3>動的機能を持たないことも、設計として選ぶ</h3>
          <p>Pages単体にはDB、ログイン、コメント、いいね、フォーム受付APIがありません。必要なら外部サービスを足せますが、今は保守対象を増やさない方を選びました。</p>
        </article>
      </div>

      <div class="pages-pipeline" data-reveal aria-label="ReactorFrontサイトの更新から公開までの流れ">
        <article><span>更新</span><strong>Astro / Git</strong><small>本文と実装を変更</small></article>
        <i aria-hidden="true">→</i>
        <article><span>確認</span><strong>Pull Request</strong><small>差分と判断を確認</small></article>
        <i aria-hidden="true">→</i>
        <article><span>検査・生成</span><strong>GitHub Actions</strong><small>検査して静的生成</small></article>
        <i aria-hidden="true">→</i>
        <article><span>公開</span><strong>Pages + CDN</strong><small>HTTPSで公開</small></article>
      </div>

      <div class="pages-edge-proof" data-reveal>
        <div class="pages-edge-proof__copy">
          <p class="eyebrow">公開と配信の仕組み</p>
          <h3>一台を持たず、GitHubの配信基盤を借りる。</h3>
          <p>
            個人で一台のWebサーバーを立てる構成では、アクセスはその一台へ集中します。
            GitHub PagesはGitHubの配信基盤と、利用者に近い拠点から配信する仕組み（CDN）を通じて静的fileを返すため、同じページへのアクセスが続いても、毎回配信元まで到達するとは限りません。
          </p>
          <p>
            GitHubは、Pagesを世界各地のデータセンターから配信し、大量の通信で停止を狙うDDoS攻撃への追加防御も提供すると説明しています。
            通常のアクセス集中や、単純な連続再読み込みを、個人管理の一台構成より受け止めやすいことも採用理由でした。
          </p>
        </div>
        <div class="pages-edge-proof__observed">
          <span>{verifiedAt}時点の実測</span>
          <h3>ReactorFront本番の応答</h3>
          <dl>
            <div><dt>HTTP</dt><dd><code>200 OK</code></dd></div>
            <div><dt>DNS</dt><dd>複数のPages用IPへ解決</dd></div>
            <div><dt>Edge</dt><dd><code>japaneast</code> / <code>cache-nrt</code></dd></div>
            <div><dt>Cache</dt><dd><code>X-Cache: HIT</code></dd></div>
          </dl>
          <p>確認時点では、東京・成田側のFastlyキャッシュから配信されました。ヘッダー名や内部構成は変更され得るため、恒久仕様としては扱いません。</p>
        </div>
      </div>

      <div class="warning-note pages-platform__limit" data-reveal>
        <strong>堅牢であることと、無敵であることは別</strong>
        <p>
          GitHub Pagesには月間通信量の目安となる上限と、一定時間内の要求回数を制限する仕組みがあり、要求過多を示すHTTP 429やサービス障害も起こり得ます。
          あらゆる規模のDDoSへ耐える保証ではありません。決済、認証、SaaS提供などへ用途が変わる場合は、別の基盤を再検討します。
        </p>
      </div>

      <aside class="reader-bridge" data-reveal>
        <div class="reader-bridge__label">
          <span>理解の補助線</span>
          <strong>要するに</strong>
        </div>
        <div>
          <h3>Webサーバー一台を無料で借りたのではなく、GitHubの開発・公開基盤へサイトを載せました。</h3>
          <p>
            本文と実装、変更履歴、差分確認、公開用fileの生成、本番公開、失敗時のlogが一つにつながり、静的fileの配信はCDNへ任せられます。
            その代わり、コメントや会員機能のような動的処理は持ちません。
          </p>
          <p class="reader-bridge__meaning"><strong>実務上の意味</strong>今の目的に不要な機能を足さず、障害点と保守対象を小さくしたまま、更新可能な公式サイトを運用できます。</p>
        </div>
      </aside>

      <p class="official-links pages-platform__links" data-reveal>
        <a href="https://docs.github.com/en/pages/getting-started-with-github-pages/what-is-github-pages" target="_blank" rel="noreferrer">GitHub公式: GitHub Pagesとは ↗</a>
        <a href="https://docs.github.com/en/pages/getting-started-with-github-pages/using-custom-workflows-with-github-pages" target="_blank" rel="noreferrer">GitHub公式: Actionsによる公開 ↗</a>
        <a href="https://github.blog/news-insights/product-news/github-pages-custom-domains-https/" target="_blank" rel="noreferrer">GitHub公式: CDNとDDoS防御 ↗</a>
        <a href="https://docs.github.com/en/pages/getting-started-with-github-pages/github-pages-limits" target="_blank" rel="noreferrer">GitHub公式: 利用上限 ↗</a>
      </p>
    </div>
  </section>

  <section class="section record-section">
    <div class="shell">
      <div class="section-heading section-heading--split" data-reveal>
        <div>
          <p class="eyebrow">Webとメールの行き先を示すDNSレコード</p>
          <h2>DNSレコードが、<br />Webとメールの<br />行き先を決める。</h2>
        </div>
        <p>
          レコード種別ごとに役割は異なります。同じ名前・種別の重複や古い値を避け、設定値は利用サービスの管理画面と公式ドキュメントから取得します。
        </p>
      </div>

      <div class="record-table" data-reveal role="table" aria-label="主要なDNSレコード">
        <div class="record-table__head" role="row">
          <span role="columnheader">種類</span><span role="columnheader">役割</span><span role="columnheader">例</span><span role="columnheader">補足</span>
        </div>
        {
          records.map((record) => (
            <div class="record-table__row" role="row">
              <strong role="cell">{record.type}</strong>
              <span role="cell">{record.role}</span>
              <code role="cell">{record.example}</code>
              <small role="cell">{record.note}</small>
            </div>
          ))
        }
      </div>

      <aside class="reader-bridge" data-reveal>
        <div class="reader-bridge__label">
          <span>理解の補助線</span>
          <strong>DNSレコードとは</strong>
        </div>
        <div>
          <h3>DNSレコードは、Webサイトやメールの本体ではなく、行き先を示す「案内票」です。</h3>
          <p>
            A・AAAA・CNAMEは主にWebの行き先、MXはメールの届け先、TXTは所有確認や送信ルールを知らせます。
            案内票を書いただけではサービスは動かないため、GitHub PagesやGoogle Workspace側の準備と対にして設定します。
          </p>
          <p class="reader-bridge__meaning"><strong>実務上の意味</strong>レコードの文字列だけでなく、案内先のサービスが受け入れ可能かまで確認する必要があります。</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--dark build-section">
    <div class="shell build-section__grid">
      <aside class="guide-index" data-reveal>
        <p class="eyebrow eyebrow--accent">構築する順番</p>
        <h2>設定する<br />順番。</h2>
        <ol>
          <li><a href="#step-1"><span>01</span>ドメインとDNS</a></li>
          <li><a href="#step-2"><span>02</span>Webサイト</a></li>
          <li><a href="#step-3"><span>03</span>仕事用メール</a></li>
          <li><a href="#step-4"><span>04</span>メール認証</a></li>
          <li><a href="#step-5"><span>05</span>外部から確認</a></li>
        </ol>
      </aside>

      <div class="guide-steps">
        <article id="step-1" data-reveal>
          <span class="guide-steps__number">01</span>
          <p class="eyebrow">ドメイン契約とDNS</p>
          <h3>名前を契約し、編集場所を確定する。</h3>
          <p>
            ドメインを契約したら、自動更新と連絡先メールを確認します。次にNSレコードを調べ、現在の権威DNSとレコード編集画面を特定します。
          </p>
          <div class="code-block">
            <div class="code-block__head"><span>PowerShell</span><span>ネームサーバーを確認</span></div>
            <pre><code>Resolve-DnsName example.com -Type NS</code></pre>
          </div>
          <ul class="task-list">
            <li>契約の自動更新と支払い方法を確認する</li>
            <li>NSの結果とDNS編集画面が一致するか確認する</li>
            <li>変更前のDNSレコードを控える</li>
          </ul>
        </article>

        <article id="step-2" data-reveal>
          <span class="guide-steps__number">02</span>
          <p class="eyebrow">Webサイト</p>
          <h3>GitHub Pagesで、<br />検査・生成・公開をつなぐ。</h3>
          <p>
            先にGitHubのrepository設定画面（<strong>Settings &gt; Pages</strong>）で、公開元をGitHub Actionsにします。
            ReactorFrontでは、<code>main</code>への反映または手動実行を起点にAstroが公開用の静的fileを生成し、成功したfileをPagesの公開環境（<code>github-pages</code> environment）から公開します。
          </p>
          <div class="pages-settings" aria-label="ReactorFrontで使用しているGitHub Pagesの主要設定">
            <div><span>01</span><strong>公開repository</strong><small>Repository</small></div>
            <div><span>02</span><strong>公開元</strong><small>Source: GitHub Actions</small></div>
            <div><span>03</span><strong>独自ドメイン</strong><small>Custom domain: <code>www.reactorfront.jp</code></small></div>
            <div><span>04</span><strong>HTTPS強制</strong><small>Enforce HTTPS</small></div>
          </div>
          <p>
            自動実行の設定（workflow）では、ソースの取得（checkout）、必要packageの導入、Astroの検査、公開用fileの生成、Pagesへの受け渡し、本番公開（deploy）を順に行います。
            公開権限は <code>contents: read</code>、<code>pages: write</code>、<code>id-token: write</code> に絞り、公開用fileの生成（build）が成功した後だけdeployを開始します。
          </p>
          <ul class="task-list">
            <li><code>main</code>へ反映したcommitと、Actionsの実行対象が一致する</li>
            <li>公開用fileの生成（build）と本番公開（deploy）の両方が成功している</li>
            <li>Pages設定に正しいカスタムドメインが表示される</li>
            <li><strong>Enforce HTTPS</strong> が有効で、本番URLがHTTPSで開く</li>
            <li>問題があれば失敗した工程を確認し、必要に応じて変更を取り消すcommit（revert）を反映する</li>
          </ul>
          <p>
            次にGitHub側でカスタムドメインを登録・検証し、DNSへA / AAAA / CNAMEを追加します。
            ルートドメインと <code>www</code> のどちらを正規URLにするかも決めます。
          </p>
          <div class="dns-example" aria-label="GitHub Pages向けDNSの一般例">
            <div><strong>A / AAAA</strong><span><code>@</code> → GitHub Pages公式のIP</span></div>
            <div><strong>CNAME</strong><span><code>www</code> → <code>owner.github.io</code></span></div>
            <div><strong>TXT</strong><span>GitHubが表示した所有確認値</span></div>
          </div>
          <div class="warning-note">
            <strong>値をこの記事から丸写ししない</strong>
            <p>IPや確認手順は変更され得ます。設定時点のGitHub公式文書と、自分のリポジトリ設定画面を正としてください。ワイルドカードDNSは使いません。</p>
          </div>
          <div class="warning-note warning-note--accent">
            <strong>公開リポジトリと静的成果物へ、秘密を入れない</strong>
            <p>APIキー、復旧コード、秘密鍵、管理画面の確認値をcommitしません。ブラウザへ配信するJavaScriptや環境変数も、利用者から見える前提で扱います。</p>
          </div>
          <p class="official-links">
            <a href="https://docs.github.com/en/pages/getting-started-with-github-pages/configuring-a-publishing-source-for-your-github-pages-site" target="_blank" rel="noreferrer">GitHub公式: 公開元の設定 ↗</a>
            <a href="https://docs.github.com/en/pages/getting-started-with-github-pages/using-custom-workflows-with-github-pages" target="_blank" rel="noreferrer">GitHub公式: Actions workflow ↗</a>
            <a href="https://docs.github.com/en/pages/configuring-a-custom-domain-for-your-github-pages-site/managing-a-custom-domain-for-your-github-pages-site" target="_blank" rel="noreferrer">GitHub公式: カスタムドメイン設定 ↗</a>
            <a href="https://docs.github.com/en/pages/configuring-a-custom-domain-for-your-github-pages-site/verifying-your-custom-domain-for-github-pages" target="_blank" rel="noreferrer">GitHub公式: ドメイン所有確認 ↗</a>
            <a href="https://docs.github.com/en/pages/getting-started-with-github-pages/securing-your-github-pages-site-with-https" target="_blank" rel="noreferrer">GitHub公式: HTTPS ↗</a>
          </p>
        </article>

        <article id="step-3" data-reveal>
          <span class="guide-steps__number">03</span>
          <p class="eyebrow">仕事用メール</p>
          <h3>Google Workspaceへメールを届ける。</h3>
          <p>
            Google Workspaceでドメイン所有を確認し、管理画面が指定するMXレコードをDNSへ登録します。
            優先度は数値が小さいほど先に使われます。既に問題なく稼働している旧形式のGoogle MXは、理由なく置き換えません。
          </p>
          <ul class="task-list">
            <li>管理画面に表示されたMXの値と優先度を使う</li>
            <li>同じドメインの不要な旧MXが混ざっていないか確認する</li>
            <li>作成した独自ドメインアドレスで送受信を試す</li>
          </ul>
          <p class="official-links">
            <a href="https://support.google.com/a/answer/6156494" target="_blank" rel="noreferrer">Google公式: MXレコード設定 ↗</a>
          </p>
        </article>

        <article id="step-4" data-reveal>
          <span class="guide-steps__number">04</span>
          <p class="eyebrow">メール送信元の認証</p>
          <h3>SPF・DKIM・DMARCを順番に有効化する。</h3>
          <p>
            3つは重複機能ではありません。送信元の許可、電子署名、失敗時の扱いという別々の役割を持ちます。
          </p>

          <div class="auth-stack">
            <section>
              <div><span>SPF</span><strong>送信元の許可リスト</strong></div>
              <p>このドメインのメールを、どのサービスが送ってよいか宣言します。</p>
              <pre><code>v=spf1 include:_spf.google.com ~all</code></pre>
            </section>
            <section>
              <div><span>DKIM</span><strong>メールへの電子署名</strong></div>
              <p>Google管理画面で2048ビット鍵を生成し、公開鍵だけをTXTへ登録します。実際の鍵は転載しません。</p>
              <pre><code>google._domainkey  TXT  &lt;管理画面が生成した公開鍵&gt;</code></pre>
            </section>
            <section>
              <div><span>DMARC</span><strong>失敗時の方針と報告</strong></div>
              <p>最初は監視だけの <code>p=none</code> で始め、報告を見てから段階的に強くします。</p>
              <pre><code>v=DMARC1; p=none; rua=mailto:dmarc@example.com</code></pre>
            </section>
          </div>

          <div class="warning-note warning-note--accent">
            <strong>DMARCは一気に <code>reject</code> へ進めない</strong>
            <p>SPFとDKIMを先に整え、少なくとも1週間はレポートを監視します。正規の送信元がすべて通ると確認してから <code>quarantine</code>、その後 <code>reject</code> を検討します。</p>
          </div>
          <p class="official-links">
            <a href="https://support.google.com/a/answer/33786" target="_blank" rel="noreferrer">Google公式: SPF ↗</a>
            <a href="https://support.google.com/a/answer/174124" target="_blank" rel="noreferrer">Google公式: DKIM ↗</a>
            <a href="https://support.google.com/a/answer/10032473" target="_blank" rel="noreferrer">Google公式: DMARC導入手順 ↗</a>
          </p>

          <aside class="reader-bridge" data-reveal>
            <div class="reader-bridge__label">
              <span>理解の補助線</span>
              <strong>三つの違い</strong>
            </div>
            <div>
              <h3>三つとも「なりすまし対策」ですが、確認しているものは別です。</h3>
              <p>
                SPFは許可された送信経路か、DKIMは正しい署名があり途中で改変されていないか、DMARCは送信元として名乗るドメインと認証結果がそろっているかを確認します。
                DMARCは、失敗したメールをどう扱い、誰へ報告するかも受信側へ伝えます。
              </p>
              <p class="reader-bridge__meaning"><strong>実務上の意味</strong>どれか一つのPASSだけで安心せず、三つの結果と正規の送信サービスを合わせて確認します。</p>
            </div>
          </aside>
        </article>

        <article id="step-5" data-reveal>
          <span class="guide-steps__number">05</span>
          <p class="eyebrow">外部からの確認</p>
          <h3>公開DNSと実際の通信を、外部から確かめる。</h3>
          <p>
            管理画面での保存だけでは完了としません。公開DNSを問い合わせ、HTTPSでサイトを開き、外部メールボックスへ送信して、受信側の認証結果まで確認します。
          </p>
          <div class="code-block">
            <div class="code-block__head"><span>PowerShell</span><span>公開DNSを確認</span></div>
            <pre><code>Resolve-DnsName example.com -Type A
Resolve-DnsName example.com -Type AAAA
Resolve-DnsName www.example.com -Type CNAME
Resolve-DnsName example.com -Type MX
Resolve-DnsName example.com -Type TXT
Resolve-DnsName _dmarc.example.com -Type TXT</code></pre>
          </div>
          <ul class="task-list">
            <li>ルートドメインと <code>www</code> の両方がHTTPSで開く</li>
            <li>片方から正規URLへ意図どおり転送される</li>
            <li>外部メールの「メッセージのソース」でSPF / DKIM / DMARCが <code>PASS</code></li>
            <li>DMARCレポートが届き、未知の送信元がない</li>
          </ul>

          <aside class="reader-bridge" data-reveal>
            <div class="reader-bridge__label">
              <span>理解の補助線</span>
              <strong>保存と反映</strong>
            </div>
            <div>
              <h3>管理画面で「保存できた」と、利用者側から「使える」は同じではありません。</h3>
              <p>
                DNSには反映やキャッシュの時間差があり、WebにはHTTPS証明書、メールには実際の配送と認証があります。
                最後は設定した管理画面ではなく、外部のDNS問い合わせ、ブラウザ、別のメールボックスから確かめます。
              </p>
              <p class="reader-bridge__meaning"><strong>実務上の意味</strong>設定者の画面だけで完了とせず、実際の利用経路からWebとメールが機能することを確認できます。</p>
            </div>
          </aside>
        </article>
      </div>
    </div>
  </section>

  <section class="section publish-safety">
    <div class="shell">
      <div class="section-heading section-heading--split" data-reveal>
        <div>
          <p class="eyebrow">公開してよい情報を分ける</p>
          <h2>ノウハウは公開する。<br />認証情報は公開しない。</h2>
        </div>
        <p>
          DNSはそもそも公開情報ですが、管理画面のスクリーンショットには公開不要な情報が混ざります。
          解説に必要な「構造」と、本人しか持つべきでない「値」を分けます。
        </p>
      </div>

      <div class="safety-grid">
        <article class="safety-card safety-card--yes" data-reveal>
          <p><span aria-hidden="true">✓</span> 公開してよい</p>
          <ul>
            <li>サービスごとの役割と構成図</li>
            <li>公開リポジトリのソースコードと変更履歴</li>
            <li>A / AAAA / MXなど公開DNSの一般例</li>
            <li>SPF・DKIM・DMARCの考え方</li>
            <li>値を伏せた管理画面の手順</li>
            <li>確認コマンドと判定基準</li>
          </ul>
        </article>
        <article class="safety-card safety-card--no" data-reveal>
          <p><span aria-hidden="true">×</span> 公開しない</p>
          <ul>
            <li>アカウントID、請求・契約情報</li>
            <li>パスワード、APIキー、二要素認証、復旧コード</li>
            <li>認証コード、EPP/AuthCode</li>
            <li>GitHub / Googleの実際の確認トークン</li>
            <li>DKIM鍵の実値や管理画面のセッションURL</li>
          </ul>
        </article>
      </div>

      <aside class="reader-bridge" data-reveal>
        <div class="reader-bridge__label">
          <span>理解の補助線</span>
          <strong>公開情報と秘密</strong>
        </div>
        <div>
          <h3>外から確認できるDNS情報と、管理画面を丸ごと公開することは別です。</h3>
          <p>
            DNSレコードは名前解決のために公開されています。一方、管理画面には契約者情報、請求、操作権限、確認トークンなど、説明には不要な情報も並びます。
            公開する時は、仕組みと確認方法を残し、本人の操作に使える値は伏せます。Gitの履歴へ一度入れた秘密は、現在のファイルから消すだけでは回収できません。
          </p>
          <p class="reader-bridge__meaning"><strong>実務上の意味</strong>読者が構成を理解できる情報量を保ちながら、アカウントを操作される手掛かりは渡さずに済みます。</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--soft operations-section">
    <div class="shell operations-section__grid">
      <div data-reveal>
        <p class="eyebrow">構築後の定期確認</p>
        <h2>構築後も続ける<br />定期運用。</h2>
      </div>
      <div class="operations-list">
        <article data-reveal><span>毎月</span><h3>期限と請求を確認</h3><p>ドメイン、Google Workspace、支払い手段、管理者への通知を確認します。</p></article>
        <article data-reveal><span>main反映後</span><h3>公開用fileの生成と本番公開を確認</h3><p><code>main</code>へ反映したcommit、GitHub Actionsによる生成（build）、Pagesへの公開（deploy）、本番URLを順に確認します。</p></article>
        <article data-reveal><span>DNS変更後</span><h3>DNSを外部確認</h3><p>レコード変更後は、権威DNSと一般の名前解決の両方を確認します。</p></article>
        <article data-reveal><span>導入直後は毎週</span><h3>DMARCレポートを見る</h3><p>未知の送信元や認証失敗がないか確認し、方針を強めてよいか判断します。</p></article>
        <article data-reveal><span>3か月ごと</span><h3>管理権限を棚卸し</h3><p>使っていないアカウント、古い回復先、不要なDNSレコードを整理します。</p></article>
      </div>
    </div>
  </section>

